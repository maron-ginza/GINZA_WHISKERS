jobs() {
  echo
  echo "=== GINZA WHISKERS / Project 02 定期実行状況（Payload Jobs Queue） ==="
  echo "（読み取り専用：このコマンド自体は新規のHTTP巡回・DB書き込みを一切行いません）"

  if ! docker info >/dev/null 2>&1 ||
     [ "$(docker inspect -f '{{.State.Running}}' "$DB_CONTAINER" 2>/dev/null)" != "true" ]; then
    fail "PostgreSQL が起動していません（先に ./p2 start を実行してください）"
    echo "================================================"
    echo
    return 1
  fi

  RAW=$(cd "$ROOT/cms" && node --env-file=.env --import=tsx/esm src/scripts/jobsStatus.ts 2>"$LOG_DIR/jobs.log" | tail -1)

  if [ -z "$RAW" ]; then
    fail "定期実行状況スクリプトの実行に失敗しました"
    echo "--- $LOG_DIR/jobs.log 末尾 ---"
    tail -15 "$LOG_DIR/jobs.log" 2>/dev/null
    echo "================================================"
    echo
    return 1
  fi

  echo "$RAW" | python3 "$ROOT/scripts/format_jobs_status.py" "$LOG_DIR/jobs.log"

  # recommend_next_step()向けのシグナル：直近の実行に失敗が含まれるかだけを判定する
  # （値の詳細解析はformat_jobs_status.py側の表示に任せ、ここでは1/0のみ）
  if echo "$RAW" | python3 -c "import sys,json; d=json.load(sys.stdin); sys.exit(0 if any(r.get('hasError') for r in d.get('recentRuns', [])) else 1)" 2>/dev/null; then
    JOBS_RECENT_FAILURE=1
  else
    JOBS_RECENT_FAILURE=0
  fi

  echo "================================================"
  echo
}

crawl() {
  echo
  echo "=== GINZA WHISKERS / Project 02 SOURCE LEDGER 自動巡回・Snapshot・Diff ==="

  if ! docker info >/dev/null 2>&1 ||
     [ "$(docker inspect -f '{{.State.Running}}' "$DB_CONTAINER" 2>/dev/null)" != "true" ]; then
    fail "PostgreSQL が起動していません（先に ./p2 start を実行してください）"
    echo "================================================"
    echo
    return 1
  fi

  MODE_ARG=""
  BUDGET_ARG=""
  for arg in "$@"; do
    if [ "$arg" = "--dry-run" ]; then
      MODE_ARG="--dry-run"
      echo "（Dry Runモード：実際にHTTP取得は行いますが、DBへの書き込みは一切行いません）"
    fi
    case "$arg" in
      --budget=*) BUDGET_ARG="$arg" ;;
    esac
  done

  RAW=$(cd "$ROOT/cms" && node --env-file=.env --import=tsx/esm src/scripts/crawlSources.ts $MODE_ARG $BUDGET_ARG 2>"$LOG_DIR/crawl.log" | tail -1)

  if [ -z "$RAW" ]; then
    fail "SOURCE LEDGER巡回スクリプトの実行に失敗しました"
    echo "--- $LOG_DIR/crawl.log 末尾 ---"
    tail -15 "$LOG_DIR/crawl.log" 2>/dev/null
    echo "================================================"
    echo
    return 1
  fi

  echo "$RAW" | python3 "$ROOT/scripts/format_crawl_status.py" "$LOG_DIR/crawl.log"

  echo "================================================"
  echo
}

tns_import_tracks() {
  echo
  echo "=== GINZA WHISKERS / Project 02 TNS MusicTracks候補曲インポート ==="

  if ! docker info >/dev/null 2>&1 ||
     [ "$(docker inspect -f '{{.State.Running}}' "$DB_CONTAINER" 2>/dev/null)" != "true" ]; then
    fail "PostgreSQL が起動していません（先に ./p2 start を実行してください）"
    echo "================================================"
    echo
    return 1
  fi

  FILE_ARG=""
  DRY_RUN_ARG=""
  for arg in "$@"; do
    if [ "$arg" = "--dry-run" ]; then
      DRY_RUN_ARG="--dry-run"
      echo "（Dry Runモード：DBへの書き込みは一切行いません）"
    elif [ -z "$FILE_ARG" ]; then
      FILE_ARG="$arg"
    fi
  done

  if [ -z "$FILE_ARG" ]; then
    fail "インポート対象ファイルを指定してください: ./p2 tns import-tracks <file> [--dry-run]"
    echo "================================================"
    echo
    return 1
  fi

  if [ ! -f "$FILE_ARG" ]; then
    fail "ファイルが見つかりません: $FILE_ARG"
    echo "================================================"
    echo
    return 1
  fi

  # cms/ へcdする前に絶対パスへ変換しておく（相対パス指定時の混乱を避ける）
  FILE_ARG="$(cd "$(dirname "$FILE_ARG")" && pwd)/$(basename "$FILE_ARG")"

  # Payload内部ロガーの警告（"No email adapter..."等）が標準出力に混ざる場合が
  # あるため、`^{`で始まる行（JSON本体）だけを抽出する（単純なtail -1だけでは
  # 警告行を誤って拾ってしまうことを実機で確認したための対策）。
  RAW=$(cd "$ROOT/cms" && node --env-file=.env --import=tsx/esm src/scripts/importTnsMusicTracks.ts "$FILE_ARG" $DRY_RUN_ARG 2>"$LOG_DIR/tns_import_tracks.log" | grep '^{' | tail -1)

  if [ -z "$RAW" ]; then
    fail "TNS候補曲インポートスクリプトの実行に失敗しました"
    echo "--- $LOG_DIR/tns_import_tracks.log 末尾 ---"
    tail -15 "$LOG_DIR/tns_import_tracks.log" 2>/dev/null
    echo "================================================"
    echo
    return 1
  fi

  echo "$RAW" | python3 -m json.tool
  echo "================================================"
  echo
}

tns_next() {
  echo
  echo "=== GINZA WHISKERS / Project 02 🌈TNS 次週Draft生成 ==="

  if ! docker info >/dev/null 2>&1 ||
     [ "$(docker inspect -f '{{.State.Running}}' "$DB_CONTAINER" 2>/dev/null)" != "true" ]; then
    fail "PostgreSQL が起動していません（先に ./p2 start を実行してください）"
    echo "================================================"
    echo
    return 1
  fi

  DRY_RUN_ARG=""
  CONFIRMED=""
  OBSERVATION_ARG=""
  FOR_WEEK_ARG=""
  for arg in "$@"; do
    case "$arg" in
      --dry-run) DRY_RUN_ARG="--dry-run" ;;
      --yes) CONFIRMED="1" ;;
      --for-week-after=*) FOR_WEEK_ARG="$arg" ;;
      --*) : ;; # 未知の--オプションは無視（観察テキストに混入させない）
      *) OBSERVATION_ARG="$arg" ;;
    esac
  done

  # Claude API課金が発生する処理（dynamic mood生成）を含むため、--yes無しでは
  # 実行しない（マロン指示「Claude API費用が発生する場合、実行前に確認できる
  # 設計にする」）。インタラクティブなy/N確認ではなく、明示フラグを必須とする
  # ——将来この処理を自動化・cron化した場合にプロンプトでハングしないため。
  if [ -z "$CONFIRMED" ]; then
    echo "⚠️  この処理は曜日ごとのdynamic mood生成のためClaude APIを1回呼び出します（小額課金）。"
    echo "    続行するには --yes を付けて再実行してください。"
    echo "    例: ./p2 tns next --yes"
    echo "        ./p2 tns next --dry-run --yes"
    echo "        ./p2 tns next --yes \"今週の銀座を一言で\""
    echo "================================================"
    echo
    return 1
  fi

  if [ -n "$DRY_RUN_ARG" ]; then
    echo "（Dry Runモード：DBへの保存は一切行いません。天気・選曲・生成予定内容の確認のみ）"
  fi

  # Payload内部ロガーの警告が標準出力に混ざる場合があるため、`^{`で始まる行
  # （JSON本体）だけを抽出する（tns_import_tracksと同じ対策）。
  RAW=$(cd "$ROOT/cms" && node --env-file=.env --import=tsx/esm src/scripts/tnsNext.ts $DRY_RUN_ARG $FOR_WEEK_ARG "$OBSERVATION_ARG" 2>"$LOG_DIR/tns_next.log" | grep '^{' | tail -1)

  if [ -z "$RAW" ]; then
    fail "TNS次週Draft生成スクリプトの実行に失敗しました"
    echo "--- $LOG_DIR/tns_next.log 末尾 ---"
    tail -20 "$LOG_DIR/tns_next.log" 2>/dev/null
    echo "================================================"
    echo
    return 1
  fi

  echo "$RAW" | python3 -m json.tool
  echo "================================================"
  echo
}


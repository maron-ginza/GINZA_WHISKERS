draft_today() {
  echo
  echo "=== GINZA WHISKERS / Project 02 「旬の銀座」日次ドラフト生成（draft-today） ==="

  if ! docker info >/dev/null 2>&1 ||
     [ "$(docker inspect -f '{{.State.Running}}' "$DB_CONTAINER" 2>/dev/null)" != "true" ]; then
    fail "PostgreSQL が起動していません（先に ./p2 start を実行してください）"
    echo "================================================"
    echo
    return 1
  fi

  DRY_RUN_ARG=""
  CONFIRMED=""
  LIMIT_ARG=""
  SINCE_ARG=""
  for arg in "$@"; do
    case "$arg" in
      --dry-run) DRY_RUN_ARG="--dry-run" ;;
      --yes) CONFIRMED="1" ;;
      --limit=*) LIMIT_ARG="$arg" ;;
      --since=*) SINCE_ARG="$arg" ;;
      --*) : ;; # 未知の--オプションは無視
    esac
  done

  # --dry-run は選定計画のみ（AI呼び出し・DB書き込みなし）なので --yes 不要。
  # live 実行は選ばれたトピック数だけ Claude API を呼ぶため、--yes を必須とする
  # （tns next と同じ「コスト発生処理は明示フラグで確認」方針）。
  if [ -z "$DRY_RUN_ARG" ] && [ -z "$CONFIRMED" ]; then
    echo "⚠️  この処理は当日承認トピックごとにClaude APIを呼び出します（トピック数ぶん、小額課金）。"
    echo "    まず ./p2 draft-today --dry-run で当日の選定計画（何本作られるか）を確認できます。"
    echo "    実際に生成するには --yes を付けて再実行してください。"
    echo "    例: ./p2 draft-today --dry-run"
    echo "        ./p2 draft-today --yes"
    echo "        ./p2 draft-today --yes --limit=3"
    echo "        ./p2 draft-today --yes --since=2026-08-27"
    echo "================================================"
    echo
    return 1
  fi

  if [ -n "$DRY_RUN_ARG" ]; then
    echo "（Dry Runモード：AI呼び出し・DB書き込みは行いません。当日の承認トピックと選定計画のみ表示）"
  fi

  # Payload内部ロガーの警告が標準出力に混ざる場合があるため、`^{`で始まる行
  # （JSON本体）だけを抽出する（tns_next と同じ対策）。
  RAW=$(cd "$ROOT/cms" && node --env-file=.env --import=tsx/esm src/scripts/draftToday.ts $DRY_RUN_ARG $LIMIT_ARG $SINCE_ARG 2>"$LOG_DIR/draft_today.log" | grep '^{' | tail -1)

  if [ -z "$RAW" ]; then
    fail "draft-today スクリプトの実行に失敗しました"
    echo "--- $LOG_DIR/draft_today.log 末尾 ---"
    tail -20 "$LOG_DIR/draft_today.log" 2>/dev/null
    echo "================================================"
    echo
    return 1
  fi

  echo "$RAW" | python3 "$ROOT/scripts/format_draft_today_status.py"
  echo "================================================"
  echo
}

draft_from_dc() {
  echo
  echo "=== GINZA WHISKERS / Project 02 単一DiscoveredContentからCORE角度1本を生成（draft-from-dc） ==="
  echo "（朝刊レビュー画面の「承認」から呼ばれる想定。指定した1件だけを生成し、他の承認済みDCは巻き込まない）"

  DC_ID=""
  CONFIRMED=""
  for arg in "$@"; do
    case "$arg" in
      --yes) CONFIRMED="1" ;;
      --dc=*) DC_ID="${arg#--dc=}" ;;
      [0-9]*) DC_ID="$arg" ;;
      --*) : ;;
    esac
  done

  if [ -z "$DC_ID" ]; then
    echo "Usage: ./p2 draft-from-dc <dcId> --yes"
    echo "================================================"
    echo
    return 1
  fi

  if ! docker info >/dev/null 2>&1 ||
     [ "$(docker inspect -f '{{.State.Running}}' "$DB_CONTAINER" 2>/dev/null)" != "true" ]; then
    fail "PostgreSQL が起動していません（先に ./p2 start を実行してください）"
    echo "================================================"
    echo
    return 1
  fi

  if [ -z "$CONFIRMED" ]; then
    echo "⚠️  この処理はDC #$DC_ID に対しClaude APIを1回呼び出します（小額課金）。"
    echo "    実行するには --yes を付けて再実行してください。例: ./p2 draft-from-dc $DC_ID --yes"
    echo "================================================"
    echo
    return 1
  fi

  RAW=$(cd "$ROOT/cms" && node --env-file=.env --import=tsx/esm src/scripts/draftFromDiscoveredContent.ts --dc="$DC_ID" 2>"$LOG_DIR/draft_from_dc.log" | grep '^{' | tail -1)

  if [ -z "$RAW" ]; then
    fail "draft-from-dc スクリプトの実行に失敗しました"
    echo "--- $LOG_DIR/draft_from_dc.log 末尾 ---"
    tail -20 "$LOG_DIR/draft_from_dc.log" 2>/dev/null
    echo "================================================"
    echo
    return 1
  fi

  echo "$RAW"
  echo "================================================"
  echo
}

draft_interest() {
  echo
  echo "=== GINZA WHISKERS / Project 02-2 収益化②「興味関心 × 銀座 × GW視点」ドラフト生成（draft-interest） ==="

  if ! docker info >/dev/null 2>&1 ||
     [ "$(docker inspect -f '{{.State.Running}}' "$DB_CONTAINER" 2>/dev/null)" != "true" ]; then
    fail "PostgreSQL が起動していません（先に ./p2 start を実行してください）"
    echo "================================================"
    echo
    return 1
  fi

  DRY_RUN_ARG=""
  CONFIRMED=""
  PASSTHRU=""
  for arg in "$@"; do
    case "$arg" in
      --dry-run) DRY_RUN_ARG="--dry-run" ;;
      --yes) CONFIRMED="1" ;;
      --limit=*|--strict|--w-paid=*|--c-match=*|--with-interest) PASSTHRU="$PASSTHRU $arg" ;;
      --*) : ;; # 未知の--オプションは無視
    esac
  done

  # --dry-run は選定計画のみ（AI呼び出し・DB書き込みなし）なので --yes 不要。
  # live 実行は選ばれたテーマ数だけ Claude API を呼ぶため、--yes を必須とする
  # （draft-today / tns next と同じ「コスト発生処理は明示フラグで確認」方針）。
  if [ -z "$DRY_RUN_ARG" ] && [ -z "$CONFIRMED" ]; then
    echo "⚠️  この処理は選定された関心テーマごとにClaude APIを呼び出します（テーマ数ぶん、小額課金）。"
    echo "    まず ./p2 draft-interest --dry-run で選定計画（W_PAID/C_MATCH・finalRankScore・接続先DC）を確認できます。"
    echo "    実際に生成するには --yes を付けて再実行してください。"
    echo "    例: ./p2 draft-interest --dry-run"
    echo "        ./p2 draft-interest --yes                          # ginza_whiskers 主稿を1テーマ1本"
    echo "        ./p2 draft-interest --yes --with-interest          # interest 補助稿も（主稿成立時のみ）"
    echo "        ./p2 draft-interest --yes --limit=3 --strict"
    echo "        ./p2 draft-interest --dry-run --w-paid=6 --c-match=0.5   # 9月Trialの感度確認"
    echo "================================================"
    echo
    return 1
  fi

  if [ -n "$DRY_RUN_ARG" ]; then
    echo "（Dry Runモード：AI呼び出し・DB書き込みは行いません。承認済みテーマの選定計画のみ表示）"
  fi

  RAW=$(cd "$ROOT/cms" && node --env-file=.env --import=tsx/esm src/scripts/draftInterest.ts $DRY_RUN_ARG $PASSTHRU 2>"$LOG_DIR/draft_interest.log" | grep '^{' | tail -1)

  if [ -z "$RAW" ]; then
    fail "draft-interest スクリプトの実行に失敗しました"
    echo "--- $LOG_DIR/draft_interest.log 末尾 ---"
    tail -20 "$LOG_DIR/draft_interest.log" 2>/dev/null
    echo "================================================"
    echo
    return 1
  fi

  echo "$RAW" | python3 "$ROOT/scripts/format_draft_interest_status.py"
  echo "================================================"
  echo
}

# 第2段階C Stage 3（2026-09-02）：テンプレート適格性チェック（読み取り専用）。
# DiscoveredContent と（あれば ready な）ArticleFacts を読み、
# mapDiscoveredContentToEventFields の判定（templateEligible / route / 不足項目）を表示する。
# DB 書き込み・Claude API・記事生成・note 投稿・NIGHT_RUN_LIVE_ENABLED 参照はしない。
# draft-today / draft-interest / night / trial 系には接続しない。
template_check() {
  echo
  echo "=== GINZA WHISKERS / Project 02 テンプレート適格性チェック（template-check・読み取り専用） ==="

  DCID=""
  for arg in "$@"; do
    case "$arg" in
      --*) : ;;
      *) [ -z "$DCID" ] && DCID="$arg" ;;
    esac
  done

  if [ -z "$DCID" ]; then
    echo "Usage: ./p2 template-check <DiscoveredContent の数値ID>"
    echo "  例: ./p2 template-check 386"
    echo "  DiscoveredContent と（あれば ready な）ArticleFacts を読み取り、"
    echo "  templateEligible / route / human_review の理由（不足項目）を表示する。"
    echo "  DB 書き込み・AI 呼び出し・記事生成・note 投稿はしない。"
    echo "================================================"
    echo
    return 1
  fi

  if ! docker info >/dev/null 2>&1 ||
     [ "$(docker inspect -f '{{.State.Running}}' "$DB_CONTAINER" 2>/dev/null)" != "true" ]; then
    fail "PostgreSQL が起動していません（先に ./p2 start を実行してください）"
    echo "================================================"
    echo
    return 1
  fi

  ( cd "$ROOT/cms" && node --env-file=.env --import=tsx/esm src/scripts/templateCheck.ts "$DCID" 2>"$LOG_DIR/template_check.log" )
  _tc_rc=$?
  if [ "$_tc_rc" -ne 0 ]; then
    fail "template-check の実行に失敗しました"
    echo "--- $LOG_DIR/template_check.log 末尾 ---"
    tail -20 "$LOG_DIR/template_check.log" 2>/dev/null
  fi
  echo "================================================"
  echo
  return "$_tc_rc"
}

# 第2段階C Stage 4（2026-09-02）：テンプレート経路 → Article(reviewStatus:draft)。
# ready かつ必須充足の ArticleFacts を持つ templateEligible:true の DiscoveredContent
# だけを、決定的テンプレ（AI なし・¥0）で Article(draft) 化する。
#   ・既定は必ず dry-run（DB 書き込みなし）。--yes 明示時のみ作成。
#   ・reviewStatus は draft 固定。自動公開・note 投稿はしない。
#   ・二重生成は editorialProvenance 逆引きで防止。
#   ・AI 経路（draft-today/draft-interest）・night・trial には接続しない。
#   ・生成した Article は既存の ./p2 night package <articleId> がそのまま処理する
#     （昨日の Night 投稿層は無変更）。
draft_template() {
  echo
  echo "=== GINZA WHISKERS / Project 02 テンプレート経路ドラフト生成（draft-template） ==="

  HAS_YES=""
  HAS_TARGET=""
  for arg in "$@"; do
    case "$arg" in
      --yes) HAS_YES="1" ;;
      --all) HAS_TARGET="1" ;;
      --*) : ;;
      *) HAS_TARGET="1" ;;
    esac
  done

  if [ -z "$HAS_TARGET" ]; then
    echo "Usage: ./p2 draft-template <DiscoveredContent の数値ID> [--dry-run] [--yes] [--force] [--regenerate]"
    echo "       ./p2 draft-template --all [--limit=N] [--dry-run] [--yes] [--force] [--regenerate]"
    echo "  例: ./p2 draft-template 386 --dry-run              # 何が作られるか確認（DB 書き込みなし）"
    echo "      ./p2 draft-template 386 --yes                  # Article(reviewStatus:draft) を新規作成"
    echo "      ./p2 draft-template 386 --yes --regenerate     # 既存の機械生成 draft を同じ Article へ上書き更新（重複を作らない）"
    echo "  ready な ArticleFacts と templateEligible:true の両方を満たす DC のみ対象。"
    echo "  既定は dry-run。--yes 明示時のみ作成。AI 呼び出し・note 投稿・自動公開はしない。"
    echo "================================================"
    echo
    return 1
  fi

  if ! docker info >/dev/null 2>&1 ||
     [ "$(docker inspect -f '{{.State.Running}}' "$DB_CONTAINER" 2>/dev/null)" != "true" ]; then
    fail "PostgreSQL が起動していません（先に ./p2 start を実行してください）"
    echo "================================================"
    echo
    return 1
  fi

  # 安全側：--yes が無ければ確実に dry-run にする（スクリプト側も既定 dry-run だが二重化）
  DT_ARGS="$*"
  if [ -z "$HAS_YES" ]; then
    case " $DT_ARGS " in
      *" --dry-run "*) : ;;
      *) DT_ARGS="$DT_ARGS --dry-run" ;;
    esac
  fi

  ( cd "$ROOT/cms" && node --env-file=.env --import=tsx/esm src/scripts/draftTemplate.ts $DT_ARGS 2>"$LOG_DIR/draft_template.log" )
  _dt_rc=$?
  if [ "$_dt_rc" -ne 0 ]; then
    fail "draft-template の実行に失敗しました"
    echo "--- $LOG_DIR/draft_template.log 末尾 ---"
    tail -20 "$LOG_DIR/draft_template.log" 2>/dev/null
  fi
  echo "================================================"
  echo
  return "$_dt_rc"
}

refresh_dates() {
  echo
  echo "=== GINZA WHISKERS / Project 02 個別ページ日付再確認（Source Coverage拡張） ==="

  if ! docker info >/dev/null 2>&1 ||
     [ "$(docker inspect -f '{{.State.Running}}' "$DB_CONTAINER" 2>/dev/null)" != "true" ]; then
    fail "PostgreSQL が起動していません（先に ./p2 start を実行してください）"
    echo "================================================"
    echo
    return 1
  fi

  MODE_ARG=""
  LIMIT_ARG=""
  ALL_ARG=""
  for arg in "$@"; do
    if [ "$arg" = "--dry-run" ]; then
      MODE_ARG="--dry-run"
      echo "（Dry Runモード：実際にHTTP再取得は行いますが、DBへの書き込みは一切行いません）"
    fi
    if [ "$arg" = "--all" ]; then
      ALL_ARG="--all"
      echo "（全件モード：日付未取得の行だけでなく295件全件を再取得し、誤抽出の訂正も反映します）"
    fi
    case "$arg" in
      --limit=*) LIMIT_ARG="$arg" ;;
    esac
  done

  RAW=$(cd "$ROOT/cms" && node --env-file=.env --import=tsx/esm src/scripts/refreshDates.ts $MODE_ARG $LIMIT_ARG $ALL_ARG 2>"$LOG_DIR/refresh_dates.log" | tail -1)

  if [ -z "$RAW" ]; then
    fail "日付再確認スクリプトの実行に失敗しました"
    echo "--- $LOG_DIR/refresh_dates.log 末尾 ---"
    tail -15 "$LOG_DIR/refresh_dates.log" 2>/dev/null
    echo "================================================"
    echo
    return 1
  fi

  echo "$RAW" | python3 "$ROOT/scripts/format_refresh_dates_status.py" "$LOG_DIR/refresh_dates.log"

  echo "================================================"
  echo
}


# ─────────────────────────────────────────────────────────────────────────────
# Project 02-2 収益化② — 9月Trial 日次データ収集オーケストレーター（2026-08-30 追加）
#
# 既存の interest_fetch_note_rising / _official / _hashtag / interest_score を
# そのまま順に呼ぶだけの薄いラッパー。cms/ 配下・スキーマ・capture ロジックは無変更。
#   - このファイルは set -e なし。1ステップが失敗しても残りは続行する。
#   - 同日重複保存は既存 capture コードが担保（新規ロジックなし）。加えて
#     「本日すでに score まで成功済みなら再実行しない」ガードを持つ（--force で無効化）。
#   - 取得件数 / warning / score 全文を .devlogs/trial/ 配下へ保存。
#   - 記事生成（draft-interest / draft-today）・承認・paid-ratio は一切呼ばない。
# launchd への登録は scripts/launchd/load.sh（このコマンドは登録・有効化しない）。
# ─────────────────────────────────────────────────────────────────────────────

# 1ステップ実行 + ログ化。$1=ラベル、$2..=呼び出す関数と引数。
# 生出力はそのまま流しつつ、trial_collect_logline.py で JSONL / 要約 / warning を記録する。
# グローバル TRIAL_LAST_RAW に最後の生出力を残す（score スナップショット用）。
_trial_step() {
  _ts_label="$1"; shift
  _ts_start=$(date +%s)
  _ts_ts="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
  _ts_out="$("$@" 2>&1)"
  _ts_rc=$?
  _ts_end=$(date +%s)

  printf '%s\n' "$_ts_out"
  TRIAL_LAST_RAW="$_ts_out"

  printf '%s\n' "$_ts_out" | python3 "$ROOT/scripts/trial_collect_logline.py" \
    "$_ts_label" "$_ts_rc" "$_ts_ts" "$((_ts_end - _ts_start))" \
    "$TRIAL_RUNLOG" "$TRIAL_SUMM_TMP" "$TRIAL_WARN_TMP" >/dev/null || true

  if [ "$_ts_rc" -ne 0 ]; then
    TRIAL_FAIL_COUNT=$((TRIAL_FAIL_COUNT + 1))
    TRIAL_FAILED_STEPS="$TRIAL_FAILED_STEPS $_ts_label"
  fi
  return "$_ts_rc"
}

interest_trial_morning() {
  FORCE=0
  for arg in "$@"; do
    case "$arg" in
      --force) FORCE=1 ;;
    esac
  done

  TRIAL_DIR="$LOG_DIR/trial"
  mkdir -p "$TRIAL_DIR"
  TRIAL_DATE="$(date +%F)"
  TRIAL_RUNLOG="$TRIAL_DIR/run_${TRIAL_DATE}.jsonl"
  TRIAL_SUMMARY="$TRIAL_DIR/trial_collect.log"
  TRIAL_SCORE_SNAP="$TRIAL_DIR/interest_score_${TRIAL_DATE}.json"
  TRIAL_SUMM_TMP="$(mktemp "$TRIAL_DIR/.summ.XXXXXX")"
  TRIAL_WARN_TMP="$(mktemp "$TRIAL_DIR/.warn.XXXXXX")"
  TRIAL_FAIL_COUNT=0
  TRIAL_FAILED_STEPS=""
  TRIAL_LAST_RAW=""
  _trial_started_at=$(date +%s)

  echo
  echo "=== GINZA WHISKERS / Project 02-2 収益化② 9月Trial 日次収集 — $(date '+%Y-%m-%d %H:%M:%S') ==="
  echo "記事生成・承認・課金は行いません（fetch-note-rising / -official / -hashtag / interest score のみ）"

  TAGS_FILE="$ROOT/config/trial_hashtags.txt"

  # --- 同日ガード: 本日すでに score まで成功していれば何もしない ---
  if [ "$FORCE" -ne 1 ] && [ -f "$TRIAL_RUNLOG" ] && \
     grep -q '"step": *"score"[^}]*"exitCode": *0' "$TRIAL_RUNLOG" 2>/dev/null; then
    ok "本日（${TRIAL_DATE}）は収集済み（score まで成功）。再実行するなら ./p2 interest trial-morning --force"
    rm -f "$TRIAL_SUMM_TMP" "$TRIAL_WARN_TMP"
    echo "================================================"
    echo
    return 0
  fi

  # --- step 0: ローカル DB 起動（CMS/Astro は起動しない。capture は Postgres 直結）---
  echo
  echo "--- step 0: ensure DB (Docker + PostgreSQL) ---"
  if ( ensure_env && start_db ); then
    ok "DB ready"
    printf '{"ts":"%s","step":"ensure_db","exitCode":0}\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" >> "$TRIAL_RUNLOG"
    printf '  %-22s : OK\n' "ensure_db" >> "$TRIAL_SUMM_TMP"
  else
    fail "DB を起動できませんでした。今回の収集を中止します（データは変更していません）"
    printf '{"ts":"%s","step":"ensure_db","exitCode":1}\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" >> "$TRIAL_RUNLOG"
    printf '  %-22s : FAIL  (中止)\n' "ensure_db" >> "$TRIAL_SUMM_TMP"
    _trial_write_summary 1
    echo "================================================"
    echo
    return 1
  fi

  # --- step 1: note 急上昇タグ ---
  echo
  echo "--- step 1: fetch-note-rising ---"
  _trial_step "rising" interest_fetch_note_rising

  # --- step 2: note 公式お題/コンテスト ---
  echo
  echo "--- step 2: fetch-note-official ---"
  _trial_step "official" interest_fetch_note_official

  # --- step 3: 追跡ハッシュタグ（config/trial_hashtags.txt、1行1タグ・# コメント可）---
  echo
  echo "--- step 3: fetch-note-hashtag（config/trial_hashtags.txt）---"
  if [ ! -f "$TAGS_FILE" ]; then
    fail "追跡タグ設定が見つかりません: $TAGS_FILE（step 3 をスキップ）"
    printf '{"ts":"%s","step":"hashtags","exitCode":1,"note":"tags file missing"}\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" >> "$TRIAL_RUNLOG"
    printf '  %-22s : FAIL  (設定ファイルなし)\n' "hashtags" >> "$TRIAL_SUMM_TMP"
    TRIAL_FAIL_COUNT=$((TRIAL_FAIL_COUNT + 1))
    TRIAL_FAILED_STEPS="$TRIAL_FAILED_STEPS hashtags"
  else
    _trial_tag_count=0
    while IFS= read -r _raw_line || [ -n "$_raw_line" ]; do
      _tag="$(printf '%s' "$_raw_line" | sed -e 's/#.*//' -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//')"
      [ -z "$_tag" ] && continue
      _trial_tag_count=$((_trial_tag_count + 1))
      echo "  · tag: $_tag"
      _trial_step "hashtag:$_tag" interest_fetch_note_hashtag "$_tag"
    done < "$TAGS_FILE"
    if [ "$_trial_tag_count" -eq 0 ]; then
      warn "追跡タグが0件でした（$TAGS_FILE の中身を確認してください）"
      printf '  %-22s : OK   (タグ0件)\n' "hashtags" >> "$TRIAL_SUMM_TMP"
    fi
  fi

  # --- step 4: Interest Score（読み取り専用）＋ 日付別スナップショット保存 ---
  echo
  echo "--- step 4: interest score（読み取り専用）---"
  _trial_step "score" interest_score
  _score_rc=$?
  if [ "$_score_rc" -eq 0 ] && [ -n "$TRIAL_LAST_RAW" ]; then
    if printf '%s\n' "$TRIAL_LAST_RAW" | python3 -c '
import json, sys
raw = sys.stdin.read()
i = raw.find("{")
while i != -1:
    try:
        obj, _ = json.JSONDecoder().raw_decode(raw[i:])
        break
    except json.JSONDecodeError:
        i = raw.find("{", i + 1)
else:
    sys.exit(1)
json.dump(obj, open(sys.argv[1], "w", encoding="utf-8"), ensure_ascii=False, indent=2)
' "$TRIAL_SCORE_SNAP"; then
      ok "score スナップショット保存: $TRIAL_SCORE_SNAP"
    else
      warn "score スナップショットの保存に失敗（JSON を取り出せませんでした）"
    fi
  fi

  _trial_write_summary "$([ "$TRIAL_FAIL_COUNT" -gt 0 ] && echo 1 || echo 0)"
  echo "================================================"
  echo
  [ "$TRIAL_FAIL_COUNT" -eq 0 ]
}

# サマリブロックを trial_collect.log へ追記し、tmp を掃除する。$1: 0=全OK / 1=失敗あり
_trial_write_summary() {
  _overall="$1"
  _elapsed=$(( $(date +%s) - ${_trial_started_at:-$(date +%s)} ))
  {
    echo "=== Trial Collect  $(date '+%Y-%m-%d %H:%M:%S')  (${TRIAL_DATE}) ==="
    [ -f "$TRIAL_SUMM_TMP" ] && cat "$TRIAL_SUMM_TMP"
    if [ -s "$TRIAL_WARN_TMP" ]; then
      echo "  warnings:"
      sed 's/^/    - /' "$TRIAL_WARN_TMP"
    else
      echo "  warnings: (none)"
    fi
    if [ "$_overall" -eq 0 ]; then
      echo "  RESULT: OK   (failed steps: none)   elapsed ${_elapsed}s"
    else
      echo "  RESULT: PARTIAL   (failed steps:${TRIAL_FAILED_STEPS:- none})   elapsed ${_elapsed}s"
    fi
    echo
  } >> "$TRIAL_SUMMARY"

  echo
  echo "--- サマリ（$TRIAL_SUMMARY へ追記済み）---"
  tail -n "$(( $(wc -l < "$TRIAL_SUMM_TMP" 2>/dev/null || echo 0) + 6 ))" "$TRIAL_SUMMARY"

  rm -f "$TRIAL_SUMM_TMP" "$TRIAL_WARN_TMP"
}

# ============================================================================
# Night Automation Layer（2026-08-31）
#   マロン就寝中に「承認済み DiscoveredContent → 記事ドラフト生成 →
#   fact/source 検証 → /note-draft パッケージ → Same-day Review Queue」までを
#   無人で進める。**公開・approve・削除・有料/無料変更・アカウント設定変更は
#   一切しない**（既存 Articles.beforeChange 人間承認ゲートも無変更）。
#   選定＋生成は ./p2 draft-today と同一コードパス（CORE 角度・reviewStatus:draft）。
# ============================================================================

_night_require_db() {
  if ! docker info >/dev/null 2>&1 ||
     [ "$(docker inspect -f '{{.State.Running}}' "$DB_CONTAINER" 2>/dev/null)" != "true" ]; then
    fail "PostgreSQL が起動していません（先に ./p2 start を実行してください）"
    echo "================================================"
    echo
    return 1
  fi
  return 0
}

night_run() {
  echo
  echo "=== GINZA WHISKERS / Project 02 Night Automation Layer（night run） ==="

  DRY_RUN_ARG=""
  CONFIRMED=""
  MAX_ARG="--max=1"
  SINCE_ARG=""
  for arg in "$@"; do
    case "$arg" in
      --dry-run) DRY_RUN_ARG="--dry-run" ;;
      --yes) CONFIRMED="1" ;;
      --max=*) MAX_ARG="$arg" ;;
      --since=*) SINCE_ARG="$arg" ;;
      --*) : ;;
    esac
  done

  # ── 運用ルール（2026-08-31 方針変更）─────────────────────────────
  # Project 02 は収益化前のため、ANTHROPIC_API_KEY を使う従量課金の
  # 夜間自動生成は実施しない。live 実行（= --dry-run なし）は既定で無効。
  # 再開するには cms/.env に NIGHT_RUN_LIVE_ENABLED=1 を明示的に追加する
  # （収益化開始・コスト方針の再確認後）。--dry-run / review / status /
  # package は課金なしのため常に利用可。
  if [ -z "$DRY_RUN_ARG" ]; then
    if ! grep -q '^NIGHT_RUN_LIVE_ENABLED=1' "$ROOT/cms/.env" 2>/dev/null; then
      warn "night run（live）は現在の運用ルールで無効化されています（Project 02 は収益化前・従量課金の夜間自動生成は実施しない）。"
      echo "    ・課金なしで使えるもの: ./p2 night run --dry-run / ./p2 night review / ./p2 night status / ./p2 night package <id>"
      echo "    ・省力化は契約内の Claude Code / Claude in Chrome を使う（有料 API を呼ばない）"
      echo "    ・再開する場合のみ: 収益化開始とコスト方針の再確認後、cms/.env に NIGHT_RUN_LIVE_ENABLED=1 を追加"
      echo "    ・note-draft / Same-day Review Queue / ERROR ログ / Claude in Chrome handoff 構造は残っている"
      echo "      （既存 draft から手動生成: ./p2 night package <articleId>）"
      echo "================================================"
      echo
      return 1
    fi
    echo "⚠️  NIGHT_RUN_LIVE_ENABLED=1 が検出されました。night run（live）は選定トピック数だけ"
    echo "    Claude API を呼び出します（従量課金）。方針を再確認のうえ実行してください。"
  fi

  _night_require_db || return 1

  if [ -z "$DRY_RUN_ARG" ] && [ -z "$CONFIRMED" ]; then
    echo "⚠️  live 実行には --yes が必要です（例: ./p2 night run --yes --max=1）。"
    echo "    まず ./p2 night run --dry-run で当日の選定計画を確認できます。"
    echo "================================================"
    echo
    return 1
  fi

  if [ -n "$DRY_RUN_ARG" ]; then
    echo "（Dry Runモード：AI呼び出し・DB書き込み・キュー書き出しは行いません。選定計画のみ表示）"
  fi

  RAW=$(cd "$ROOT/cms" && node --env-file=.env --import=tsx/esm src/scripts/nightBuild.ts \
    $DRY_RUN_ARG $MAX_ARG $SINCE_ARG 2>"$LOG_DIR/night.log" | grep '^{' | tail -1)

  if [ -z "$RAW" ]; then
    fail "night run スクリプトの実行に失敗しました"
    echo "--- $LOG_DIR/night.log 末尾 ---"
    tail -20 "$LOG_DIR/night.log" 2>/dev/null
    echo "================================================"
    echo
    return 1
  fi

  echo "$RAW" | python3 "$ROOT/scripts/format_night_status.py"
  echo "================================================"
  echo
}

night_review() {
  echo
  echo "=== GINZA WHISKERS / Project 02 Night — Same-day Review Queue ==="
  DATE_ARG=""
  for arg in "$@"; do
    case "$arg" in
      --date=*) DATE_ARG="$arg" ;;
    esac
  done
  RAW=$(cd "$ROOT/cms" && node --import=tsx/esm src/scripts/nightBuild.ts --review $DATE_ARG 2>"$LOG_DIR/night.log" | grep '^{' | tail -1)
  if [ -z "$RAW" ]; then
    fail "night review の実行に失敗しました"
    tail -20 "$LOG_DIR/night.log" 2>/dev/null
    echo "================================================"
    echo
    return 1
  fi
  echo "$RAW" | python3 "$ROOT/scripts/format_night_status.py"
  echo "================================================"
  echo
}

night_status() {
  echo
  echo "=== GINZA WHISKERS / Project 02 Night — 状態確認（読み取り専用） ==="
  RAW=$(cd "$ROOT/cms" && node --import=tsx/esm src/scripts/nightBuild.ts --status 2>"$LOG_DIR/night.log" | grep '^{' | tail -1)
  if [ -z "$RAW" ]; then
    fail "night status の実行に失敗しました"
    tail -20 "$LOG_DIR/night.log" 2>/dev/null
    echo "================================================"
    echo
    return 1
  fi
  echo "$RAW" | python3 "$ROOT/scripts/format_night_status.py"
  echo "================================================"
  echo
}

night_package() {
  echo
  echo "=== GINZA WHISKERS / Project 02 Night — /note-draft パッケージ再生成 ==="
  ID="$1"
  if [ -z "$ID" ]; then
    echo "Usage: ./p2 night package <articleId>（既存の draft Article を /note-draft 構造へ再変換）"
    echo "================================================"
    echo
    return 1
  fi
  _night_require_db || return 1
  RAW=$(cd "$ROOT/cms" && node --env-file=.env --import=tsx/esm src/scripts/nightBuild.ts --package="$ID" 2>"$LOG_DIR/night.log" | grep '^{' | tail -1)
  if [ -z "$RAW" ]; then
    fail "night package の実行に失敗しました"
    tail -20 "$LOG_DIR/night.log" 2>/dev/null
    echo "================================================"
    echo
    return 1
  fi
  echo "$RAW" | python3 "$ROOT/scripts/format_night_status.py"
  echo "================================================"
  echo
}

night_check() {
  echo
  echo "=== GINZA WHISKERS / Project 02 Night — note 転記前チェック ==="
  ID="$1"
  COPY_BODY=0
  shift 2>/dev/null || true
  for a in "$@"; do
    [ "$a" = "--copy-body" ] && COPY_BODY=1
  done
  if [ -z "$ID" ]; then
    echo "Usage: ./p2 night check <articleId> [--copy-body]"
    echo "  draft / approved / published いずれも対象（読み取り専用・DBも本文も変更しない）。"
    echo "  --copy-body : note 本文だけを macOS のクリップボードへコピー（pbcopy）。"
    echo "================================================"
    echo
    return 1
  fi
  _night_require_db || return 1
  RAW=$(cd "$ROOT/cms" && node --env-file=.env --import=tsx/esm src/scripts/nightBuild.ts --check="$ID" 2>"$LOG_DIR/night.log" | grep '^{' | tail -1)
  if [ -z "$RAW" ]; then
    fail "night check の実行に失敗しました"
    tail -20 "$LOG_DIR/night.log" 2>/dev/null
    echo "================================================"
    echo
    return 1
  fi
  echo "$RAW" | python3 "$ROOT/scripts/format_night_status.py"
  if [ "$COPY_BODY" = "1" ]; then
    BODY_REL=$(echo "$RAW" | python3 -c 'import sys,json;print((json.load(sys.stdin).get("files") or {}).get("body",""))')
    if [ -n "$BODY_REL" ] && [ -f "$ROOT/$BODY_REL" ] && command -v pbcopy >/dev/null 2>&1; then
      pbcopy < "$ROOT/$BODY_REL"
      echo "  📋 note 本文をクリップボードへコピーしました（$BODY_REL）"
    else
      echo "  ⚠️  クリップボードへのコピーをスキップ（pbcopy 不在 or 本文ファイル無し）"
    fi
  fi
  echo "================================================"
  echo
}

night_dispatch() {
  case "$1" in
    run)
      shift
      night_run "$@"
      ;;
    review)
      shift
      night_review "$@"
      ;;
    status)
      night_status
      ;;
    package)
      shift
      night_package "$@"
      ;;
    check)
      shift
      night_check "$@"
      ;;
    *)
      echo "Usage:"
      echo "  ./p2 night run [--dry-run] [--yes] [--max=N] [--since=YYYY-MM-DD]"
      echo "        当日 curationStatus=approved の DiscoveredContent から最大N本（既定1）を"
      echo "        CORE角度で記事draft化 → fact/source検証 → /note-draft パッケージ →"
      echo "        Same-day Review Queue（.devlogs/night/）へ書き出す。--dry-run は選定計画のみ、"
      echo "        実生成は --yes 必須。異常検出時は処理を停止し ERROR ログと未処理項目をキューに残す。"
      echo "        公開・approve・削除・有料/無料変更は行わない。"
      echo "  ./p2 night review [--date=YYYY-MM-DD]   当日レビュー：Same-day Review Queue を表示（DB不要）"
      echo "  ./p2 night status                       直近の night run の結果を表示（DB不要）"
      echo "  ./p2 night package <articleId>          既存の draft Article を /note-draft 構造へ再変換"
      echo "  ./p2 night check <articleId> [--copy-body]  note 転記前チェック（1画面・読み取り専用。"
      echo "                                             --copy-body で本文をクリップボードへ）"
      return 1
      ;;
  esac
}

interest_dispatch() {
  case "$1" in
    fetch-note-rising)
      shift
      interest_fetch_note_rising "$@"
      ;;
    fetch-note-official)
      shift
      interest_fetch_note_official "$@"
      ;;
    fetch-note-hashtag)
      shift
      interest_fetch_note_hashtag "$@"
      ;;
    score)
      interest_score
      ;;
    paid-ratio)
      shift
      interest_paid_ratio "$@"
      ;;
    trial-morning)
      shift
      interest_trial_morning "$@"
      ;;
    *)
      echo "Usage:"
      echo "  ./p2 interest fetch-note-rising [--dry-run]"
      echo "  ./p2 interest fetch-note-official [--dry-run]"
      echo "  ./p2 interest fetch-note-hashtag <tag> [--dry-run]"
      echo "  ./p2 interest score  (読み取り専用、Phase A統合Interest Score表示)"
      echo "  ./p2 interest paid-ratio <theme|id> [--dry-run]  (Phase B、note.com公開ページから paidRatio を算出し monetizationグループへ保存)"
      echo "  ./p2 interest trial-morning [--force]  (9月Trial 日次収集: rising→official→追跡タグ→score を一括。1処理失敗でも続行、同日再実行はガード、記事生成なし)"
      return 1
      ;;
  esac
}

start_all() {
  echo
  echo "🚀 Project 02 自動起動開始"

  ensure_env || exit 1
  start_db
  start_cms
  start_site
  health
}

# 値は一切表示しない。「設定されているかどうか」の存在確認のみ行う。
check_env_var() {
  file="$1"
  var="$2"
  line=$(grep -E "^${var}=" "$file" 2>/dev/null | head -1)

  if [ -z "$line" ]; then
    warn "  $var : 未設定"
    return 1
  fi

  value="${line#*=}"
  if [ -z "$value" ]; then
    warn "  $var : 空文字（キーはあるが値が未入力）"
    return 1
  fi

  ok "  $var : 設定済み（値は表示しません）"
  return 0
}

# 値は一切表示しない。形式（sk-ant-プレフィックス・長さ・空白有無）のみで
# 「APIキーとして成立しているか」を判定する。実際の認証成功は保証しない
# （2026-08-10 実AI E2E検証セッションで、形式異常な値が.envに混入していた
# 事例があったため、日次チェックとして静的検査のみ追加した）。
check_anthropic_key_format() {
  file="$1"
  line=$(grep -E "^ANTHROPIC_API_KEY=" "$file" 2>/dev/null | head -1)
  ANTHROPIC_KEY_OK=0

  if [ -z "$line" ]; then
    return 1
  fi

  value="${line#*=}"
  len=${#value}

  if [ -z "$value" ]; then
    warn "  ANTHROPIC_API_KEY 形式チェック : 空文字のためスキップ"
    return 1
  fi

  case "$value" in
    sk-ant-*) prefix_ok=1 ;;
    *) prefix_ok=0 ;;
  esac

  case "$value" in
    *' '*) has_space=1 ;;
    *) has_space=0 ;;
  esac

  if [ "$prefix_ok" = "1" ] && [ "$has_space" = "0" ] && [ "$len" -lt 200 ]; then
    ok "  ANTHROPIC_API_KEY 形式チェック : 正常な形式に見えます（sk-ant-始まり、${len}文字。実際の認証成功は保証しません）"
    ANTHROPIC_KEY_OK=1
    return 0
  else
    warn "  ANTHROPIC_API_KEY 形式チェック : 異常の疑いあり（sk-ant-始まり=${prefix_ok}、空白含む=${has_space}、長さ=${len}文字。値は表示していません）"
    return 1
  fi
}

# === Railway / Cloudflare 読み取り専用ラッパー（2026-08-12新設） ===
#
# 背景：`railway domain` をサブコマンドなしで実行し、Postgresサービスに
# 公開ドメインを誤って作成する事故が発生した（発見後 `railway domain delete`
# で削除し、読み取り専用コマンドで復旧確認済み。実データ・デプロイ・環境変数
# への影響はなし）。原因は「一覧表示のつもりで叩いたコマンドが、実際には
# サブコマンド省略時に暗黙で『作成』動作をする」仕様を、実行前に`--help`で
# 確認していなかったこと。
#
# 再発防止として、以後Railway/Cloudflareの読み取り専用操作は必ずこの
# railway_ro / wrangler_ro を経由すること。ここに無い操作を実行する場合は、
# 生成AIエージェントは自動実行せず、実行直前で必ず停止して人間の承認を得る
# こと。新しい操作をここへ追加する前に、必ず `railway <cmd> --help` /
# `wrangler <cmd> --help` を読み、サブコマンド省略時に作成・変更が起きない
# ことを確認すること。
#
# 【許可リストに追加してはいけない操作（＝実行前に必ず人間の承認が必要）】
#   Railway: domain（create/update/delete）、variable set/delete、up、
#            deploy、redeploy、restart、down、delete、init、
#            service（create相当）、environment（create/delete）、volume、
#            scale、connect/ssh（本番DBへの対話シェル）、config apply、
#            usage limit set/update/remove（課金上限の変更）
#   Cloudflare: pages deploy、r2 bucket create/delete、deploy/publish、
#            kv:*、d1 *、secret put、login/logout
railway_ro() {
  case "$1" in
    whoami)              railway whoami ;;
    status)              railway status --json ;;
    domain-list)         shift; railway domain list --service "$1" ;;
    domain-status)       shift; railway domain status "$1" --service "$2" ;;
    deployment-list)     shift; railway deployment list --service "$1" ;;
    variable-list-keys)  shift; railway variable list --service "$1" --json 2>/dev/null | jq -r 'keys[]' ;;
    usage)               railway usage ;;
    usage-limit-status)  railway usage limit status ;;
    *)
      fail "railway_ro: 未許可の操作 '$1'（追加する前に railway <cmd> --help で安全性を確認してください）"
      return 1
      ;;
  esac
}

wrangler_ro() {
  case "$1" in
    whoami)              env -u CLOUDFLARE_API_TOKEN wrangler whoami ;;
    pages-project-list)  env -u CLOUDFLARE_API_TOKEN wrangler pages project list ;;
    r2-bucket-list)      env -u CLOUDFLARE_API_TOKEN wrangler r2 bucket list ;;
    *)
      fail "wrangler_ro: 未許可の操作 '$1'（追加する前に wrangler <cmd> --help で安全性を確認してください）"
      return 1
      ;;
  esac
}

# 現状Railway上に存在するサービス一覧（cmsサービスが将来デプロイされたら
# "Postgres cms" のように増やすだけでよい）
RAILWAY_KNOWN_SERVICES="Postgres"

prod_status() {
  echo
  echo "=== GINZA WHISKERS / Project 02 本番リソース状態（読み取り専用） ==="
  echo "作成・変更・削除・デプロイは一切行いません（railway_ro/wrangler_ro経由の読み取りのみ）"
  echo

  echo "--- Railway ---"
  if ! command -v railway >/dev/null 2>&1; then
    warn "railway CLI 未インストール"
  elif ! (cd "$ROOT/cms" && railway_ro whoami >/dev/null 2>&1); then
    warn "railway 未ログイン（本コマンドからはログインしません）"
  else
    ok "railway 認証: 有効"
    echo
    echo "  [usage（課金確認）]"
    (cd "$ROOT/cms" && railway_ro usage) | sed 's/^/  /'
    echo
    echo "  [status]"
    (cd "$ROOT/cms" && railway_ro status) | sed 's/^/  /'

    for svc in $RAILWAY_KNOWN_SERVICES; do
      echo
      echo "  [$svc: domains]"
      (cd "$ROOT/cms" && railway_ro domain-list "$svc") | sed 's/^/  /'
      echo
      echo "  [$svc: deployments]"
      (cd "$ROOT/cms" && railway_ro deployment-list "$svc") | sed 's/^/  /'
      echo
      echo "  [$svc: 環境変数キー一覧（値は表示しません）]"
      (cd "$ROOT/cms" && railway_ro variable-list-keys "$svc") | sed 's/^/    /'
    done
  fi

  echo
  echo "--- Cloudflare ---"
  if ! command -v wrangler >/dev/null 2>&1; then
    warn "wrangler CLI 未インストール"
  elif ! wrangler_ro whoami >/dev/null 2>&1; then
    warn "wrangler 未ログイン、または認証切れ（本コマンドからはログインしません）"
  else
    ok "wrangler 認証: 有効"
    echo
    echo "  [Cloudflare Pages プロジェクト一覧]"
    wrangler_ro pages-project-list | sed 's/^/  /'
    echo
    echo "  [R2 バケット一覧]"
    wrangler_ro r2-bucket-list | sed 's/^/  /'
  fi

  echo
  echo "================================================"
  echo
}

pmo() {
  morning || return 1
  prod_status
}

preflight() {
  echo
  echo "=== GINZA WHISKERS / Project 02 Phase 12 Preflight（本番インフラ構築準備） ==="
  echo "外部アカウント作成・課金操作・DNS変更・本番公開は行いません（調査・ローカル検証のみ）"
  echo

  echo "--- 1. デプロイ関連ファイルの存在確認 ---"
  [ -f "$ROOT/cms/railway.json" ] && ok "cms/railway.json（Railway build/start/healthcheck設定）" || warn "cms/railway.json が見つかりません"
  [ -f "$ROOT/cms/docker-compose.yml" ] && ok "cms/docker-compose.yml（ローカルPostgres用、本番では不使用）" || warn "cms/docker-compose.yml が見つかりません"
  grep -q '"engines"' "$ROOT/site/package.json" 2>/dev/null && ok "site/package.json に engines.node 指定あり" || warn "site/package.json に engines.node がありません"
  [ -f "$ROOT/cms/.env.example" ] && ok "cms/.env.example" || warn "cms/.env.example が見つかりません"
  [ -f "$ROOT/site/.env.example" ] && ok "site/.env.example" || warn "site/.env.example が見つかりません"

  echo
  echo "--- 2. cms/.env の必須環境変数（名前のみ確認、値は表示しません） ---"
  if [ -f "$ROOT/cms/.env" ]; then
    db_ok=1
    check_env_var "$ROOT/cms/.env" "DATABASE_URI" || db_ok=0
    if [ "$db_ok" = "0" ]; then
      check_env_var "$ROOT/cms/.env" "DATABASE_URL" && db_ok=1
    fi
    [ "$db_ok" = "1" ] || warn "  DATABASE_URI / DATABASE_URL のいずれも未設定です"
    check_env_var "$ROOT/cms/.env" "PAYLOAD_SECRET"
    check_env_var "$ROOT/cms/.env" "R2_BUCKET"
    check_env_var "$ROOT/cms/.env" "R2_ENDPOINT"
    check_env_var "$ROOT/cms/.env" "R2_ACCESS_KEY_ID"
    check_env_var "$ROOT/cms/.env" "R2_SECRET_ACCESS_KEY"
    check_env_var "$ROOT/cms/.env" "ANTHROPIC_API_KEY" && check_anthropic_key_format "$ROOT/cms/.env"
    check_env_var "$ROOT/cms/.env" "X_API_BEARER_TOKEN"
    check_env_var "$ROOT/cms/.env" "IG_BUSINESS_ACCOUNT_ID"
    check_env_var "$ROOT/cms/.env" "IG_PAGE_ACCESS_TOKEN"
  else
    fail "cms/.env が存在しません"
  fi

  echo
  echo "--- 3. site/.env の必須環境変数（名前のみ確認） ---"
  if [ -f "$ROOT/site/.env" ]; then
    check_env_var "$ROOT/site/.env" "PAYLOAD_API_URL"
  else
    fail "site/.env が存在しません"
  fi

  echo
  echo "--- 4. デプロイ用CLIツールの検出（読み取りのみ、ログイン等は行いません） ---"
  RAILWAY_AUTH_OK=0
  WRANGLER_AUTH_OK=0

  if command -v railway >/dev/null 2>&1; then
    ok "railway CLI インストール済み"
    if railway whoami >/dev/null 2>&1; then
      ok "railway 認証: 有効"
      RAILWAY_AUTH_OK=1
    else
      warn "railway 認証: 未ログイン（本スクリプトからはログインしません。ユーザー側でのブラウザ操作が必要）"
    fi
  else
    warn "railway CLI 未インストール（Railwayダッシュボードでの手動設定が必要）"
  fi

  if command -v wrangler >/dev/null 2>&1; then
    ok "wrangler CLI インストール済み（$(wrangler --version 2>/dev/null | head -1)）"
    if wrangler whoami >/dev/null 2>&1; then
      ok "wrangler 認証: 有効"
      WRANGLER_AUTH_OK=1
    else
      warn "wrangler 認証: 無効または期限切れ（再ログインが必要、本スクリプトからは実行しません）"
    fi
  else
    warn "wrangler CLI 未インストール"
  fi

  echo
  echo "--- 5. ローカルビルド・型チェック ---"
  if (cd "$ROOT/cms" && npx tsc --noEmit >"$LOG_DIR/preflight_cms_tsc.log" 2>&1); then
    ok "cms: tsc --noEmit エラーなし"
  else
    known=$(grep -c "createDraftFromSource.ts" "$LOG_DIR/preflight_cms_tsc.log" 2>/dev/null || echo 0)
    total=$(grep -c "error TS" "$LOG_DIR/preflight_cms_tsc.log" 2>/dev/null || echo 0)
    if [ "$known" = "$total" ] && [ "$total" != "0" ]; then
      warn "cms: tsc --noEmit は既知の${total}件のみ（createDraftFromSource.ts、Phase 8以前からの既知エラー）"
    else
      fail "cms: tsc --noEmit で未知のエラーあり（詳細: $LOG_DIR/preflight_cms_tsc.log）"
    fi
  fi

  if (cd "$ROOT/site" && npx astro check >"$LOG_DIR/preflight_astro_check.log" 2>&1); then
    ok "site: astro check エラーなし"
  else
    fail "site: astro check でエラーあり（詳細: $LOG_DIR/preflight_astro_check.log）"
  fi

  echo
  echo "================================================"
  echo
}

# preflight() が設定したWRANGLER_AUTH_OK/RAILWAY_AUTH_OK/ANTHROPIC_KEY_OKを
# 読み、今日進めるべき工程を1つだけ提案する。優先順位は
# 「ローカル環境の健全性 > 外部認証の復旧 > APIキーの健全性 > 本番構築の続き」。
recommend_next_step() {
  echo "=== 今日の次の推奨工程（1つだけ） ==="

  if [ "${WRANGLER_AUTH_OK:-0}" != "1" ]; then
    echo "→ wrangler login を実行し、Cloudflareの認証を復旧してください（本コマンドからは自動実行しません）"
  elif [ "${RAILWAY_AUTH_OK:-0}" != "1" ]; then
    echo "→ railway login を実行し、Railwayの認証を完了してください（ブラウザでの操作が必要、本コマンドからは自動実行しません）"
  elif [ "${ANTHROPIC_KEY_OK:-0}" != "1" ]; then
    echo "→ cms/.env の ANTHROPIC_API_KEY を、Anthropicコンソールで発行した有効な値（sk-ant-で始まる）に差し替えてください"
  elif [ "${JOBS_RECENT_FAILURE:-0}" = "1" ]; then
    echo "→ SOURCE LEDGER自動巡回（Jobs Queue）に直近の失敗があります。./p2 jobs で詳細を確認してください"
  else
    echo "→ 付録Fの手順で Cloudflare Pages / Railway デプロイ / R2 有効化など、本番インフラの実際の構築を進めてください（各サービスのダッシュボード操作が必要）"
  fi

  echo
}

morning() {
  echo
  echo "🌅 Project 02 Morning Startup — $(date '+%Y-%m-%d %H:%M:%S')"
  echo "外部ログイン・課金操作・本番デプロイは行いません（ローカル起動・診断・状態確認のみ）"
  echo
  # Project 02 日次パイプラインの処理順（2026-08-28、draft-today＋draft-interest 接続時に明示）:
  #   情報収集（SOURCE LEDGER自動巡回 = Payload Jobs Queue、morning外・課金なし）
  #     → 抽出・採点（./p2 crawl / ./p2 score / ./p2 score-articles、morning外・Claude課金あり）
  #     → curation（人間: Payload管理画面で Maron Editor's Choice。
  #         DiscoveredContent と interest-themes の両方が対象）
  #     → approved判定（人間承認ゲート、req.user必須:
  #         DiscoveredContent.curationStatus = approved ／ interest-themes.status = approved）
  #     → 収益化① draft-today（当日approved DiscoveredContent → 類似除外 → 上位最大5トピックを
  #         各1本 CORE角度で reviewStatus:draft 生成。最大5本/日）
  #     → 収益化② draft-interest（承認済み interest-themes → topicInterestScore × monetizationMultiplier
  #         〈Phase B、W_PAID/C_MATCH は config から取得〉で順位付け → 承認済み DiscoveredContent
  #         〈収益化①で記事化済みのものは除外〉へプレマッチ → interest / ginza_whiskers 角度で
  #         reviewStatus:draft 生成。最大5本/日）
  #     → 承認待ち一覧（reviewStatus:draft、合計 最大10本/日）= 編集長レビュー対象
  # morning はこのうち draft-today と draft-interest を **どちらも --dry-run** で「予定確認」まで
  # 行う（AI呼び出し・DB書き込みなし）。実生成は人間が別途 ./p2 draft-today --yes ／
  # ./p2 draft-interest --yes を明示実行した場合のみ。morning は課金操作・自動投稿を一切
  # 行わない（既存方針の維持）。同日再実行しても --dry-run は何も生成せず、--yes 実行も
  # editorialProvenance 逆引き／interest-themes.generatedArticles で二重生成しない。
  # 本番 Railway では TZ=Asia/Tokyo が前提（当日判定・Interest Score freshness、RUNBOOKS 付録F）。

  ensure_env || {
    echo
    echo "次の1操作: cms/.env（と必要ならsite/.env）を用意してから ./p2 morning を再実行してください"
    return 1
  }

  echo "--- 1-2. Docker Engine / PostgreSQL ---"
  if ! wait_docker; then
    echo
    echo "次の1操作: Docker Desktopを手動起動し、再度 ./p2 morning を実行してください"
    return 1
  fi

  if ! docker inspect "$DB_CONTAINER" >/dev/null 2>&1; then
    fail "PostgreSQL container が見つかりません"
    echo
    echo "次の1操作: cms/docker-compose.yml の存在を確認し 'docker compose up -d' を実行してください"
    return 1
  fi

  if [ "$(docker inspect -f '{{.State.Running}}' "$DB_CONTAINER" 2>/dev/null)" = "true" ]; then
    ok "PostgreSQL already running"
  else
    if ! docker start "$DB_CONTAINER" >/dev/null; then
      fail "PostgreSQL 起動失敗"
      echo
      echo "次の1操作: docker logs $DB_CONTAINER でエラー内容を確認してください"
      return 1
    fi
    ok "PostgreSQL started"
  fi

  echo
  echo "--- 3. Payload CMS ---"
  start_cms
  if ! http_ok "$CMS_URL/api/articles"; then
    echo
    echo "次の1操作: tail -50 $LOG_DIR/cms.log でエラー内容を確認してください"
    return 1
  fi

  echo
  echo "--- 4. Astro ---"
  start_site
  if ! http_ok "$SITE_URL/ja/"; then
    echo
    echo "次の1操作: tail -50 $LOG_DIR/site.log でエラー内容を確認してください"
    return 1
  fi

  echo
  echo "--- 5. ./p2 status 相当 ---"
  health

  echo "--- 6. ./p2 doctor 相当（診断ログ） ---"
  dump_logs

  echo "--- 7. ./p2 editorial 相当 ---"
  editorial

  echo "--- 8. ./p2 social 相当 ---"
  social

  echo "--- 9. ./p2 jobs 相当（SOURCE LEDGER定期実行の状態確認、読み取り専用） ---"
  jobs

  echo "--- 10〜12. Phase 12 Preflight状態確認（Claude APIキー形式・Railway/Cloudflare認証は警告表示のみ、ログインは行いません） ---"
  preflight

  echo "--- AM. 明朝パイプライン（単一経路）: preflight → 6:00収集確認 → 公式ページ取得(--fetch) → 重複除去 → ArticleFacts候補抽出 → ArticleFacts登録(差分) → A/B/C判定 → 画像preflight → 順位付け → 7:10候補レポート＋8:00意思決定サポート ---"
  echo "    （DB書き込みなし・Claude API・課金なし。--fetch は 2026-09-02 検証で有効化〈緊急停止 MORNING_FETCH=0〉。"
  echo "     --register-facts は ArticleFacts の登録予定差分を表示するのみ。実書き込みは ./p2 morning --write-facts か MORNING_WRITE_FACTS=1 のとき draft のみ登録。レポートは .devlogs/morning/<date>/ へ保存）"
  am_run --fetch --register-facts "$@" || true

  echo "--- 13. 収益化① ./p2 draft-today --dry-run 相当（当日approved DiscoveredContent → 本日ドラフト化予定の確認。AI呼び出し・DB書き込みなし。実生成は別途 ./p2 draft-today --yes） ---"
  draft_today --dry-run

  echo "--- 14. 収益化② ./p2 draft-interest --dry-run 相当（承認済み interest-themes → finalRankScore 順位付け → 承認済みDCへプレマッチの確認。AI呼び出し・DB書き込みなし。実生成は別途 ./p2 draft-interest --yes） ---"
  draft_interest --dry-run

  recommend_next_step

  echo "🌅 Project 02 Morning Startup 完了"
  echo
}

# ─────────────────────────────────────────────────────────────
# ./p2 am-preflight  — 早朝（5:50）環境確認（読み取り専用・P0 2026-09-02）
#   電源／ネットワーク／ディスク／Docker／PostgreSQL／Payload／必要プロセスを
#   確認するだけ。sudo・管理者権限・OS 設定変更・DB 書き込み・課金は一切しない。
#   pmset のスリープ復帰スケジュールは「読み取り」のみ（変更は提案に留める）。
#   Claude in Chrome / ブラウザには一切触れない。
# ─────────────────────────────────────────────────────────────
am_preflight() {
  echo
  echo "=== GINZA WHISKERS / Project 02 早朝 preflight（読み取り専用・5:50 チェック） ==="
  echo "（このコマンドは OS 設定変更・sudo・DB 書き込み・課金・ブラウザ操作を一切行いません）"
  local WARN=0

  # 1. 電源（AC 接続 / バッテリー残量）
  if command -v pmset >/dev/null 2>&1; then
    local PWRLINE
    PWRLINE=$(pmset -g batt 2>/dev/null | tail -n +1 | tr '\n' ' ')
    case "$PWRLINE" in
      *"'AC Power'"*) ok "電源: AC 接続" ;;
      *"'Battery Power'"*) warn "電源: バッテリー駆動（夜間は AC 接続推奨。Docker コールドスタートが間に合わない場合あり）"; WARN=$((WARN+1)) ;;
      *) warn "電源: 状態を判定できません（$PWRLINE）"; WARN=$((WARN+1)) ;;
    esac
  else
    warn "電源: pmset が使えません"; WARN=$((WARN+1))
  fi

  # 2. スリープ復帰スケジュール（読み取りのみ）
  local SCHED
  SCHED=$(pmset -g sched 2>/dev/null | grep -iE 'wake|poweron' | head -3 | sed 's/^ *//')
  if [ -n "$SCHED" ]; then
    ok "スリープ復帰スケジュール（読み取り）:"
    echo "$SCHED" | sed 's/^/     /'
    if echo "$SCHED" | grep -qiE '6:5[0-9]AM|06:5[0-9]'; then
      warn "現在の自動復帰は 6:55 頃。固定運用は 5:50 復帰 → 6:00 収集。5:50 化は要 OS 設定変更（下記）"
      WARN=$((WARN+1))
    fi
  else
    warn "スリープ復帰スケジュール未設定（`sudo pmset repeat` はマロンが実行）"; WARN=$((WARN+1))
  fi

  # 3. ディスク空き容量
  local DISKAVAIL DISKPCT
  DISKAVAIL=$(df -h "$ROOT" 2>/dev/null | awk 'NR==2{print $4}')
  DISKPCT=$(df -h "$ROOT" 2>/dev/null | awk 'NR==2{gsub("%","",$5); print $5}')
  if [ -n "$DISKPCT" ] && [ "$DISKPCT" -lt 92 ] 2>/dev/null; then
    ok "ディスク空き: ${DISKAVAIL}（使用 ${DISKPCT}%）"
  else
    warn "ディスク空き: ${DISKAVAIL:-不明}（使用 ${DISKPCT:-?}%）— 収集ログの保存先を確認"; WARN=$((WARN+1))
  fi

  # 4. ネットワーク到達性（HEAD のみ・本文は取得しない＝未信頼データを読み込まない）
  local NET_OK=0
  for host in "https://www.ginza.jp" "https://note.com"; do
    if curl -sI -m 6 -o /dev/null -w '%{http_code}' "$host" 2>/dev/null | grep -qE '^[23]'; then
      ok "ネットワーク到達: $host"
      NET_OK=$((NET_OK+1))
    else
      warn "ネットワーク到達不可: $host"; WARN=$((WARN+1))
    fi
  done
  [ "$NET_OK" -eq 0 ] && fail "収集元へ到達できません（6:00 収集は失敗する見込み）"

  # 5. Docker Engine
  if docker info >/dev/null 2>&1; then
    ok "Docker Engine"
  else
    fail "Docker Engine 停止中（./p2 start で起動。夜間は Docker Desktop を『ログイン時に起動』推奨）"; WARN=$((WARN+1))
  fi

  # 6. PostgreSQL コンテナ + 応答
  if [ "$(docker inspect -f '{{.State.Running}}' "$DB_CONTAINER" 2>/dev/null)" = "true" ]; then
    if docker exec "$DB_CONTAINER" pg_isready -U discover_ginza >/dev/null 2>&1; then
      ok "PostgreSQL (${DB_CONTAINER}): 応答あり"
    else
      warn "PostgreSQL コンテナは起動しているが pg_isready が応答しません"; WARN=$((WARN+1))
    fi
  else
    warn "PostgreSQL (${DB_CONTAINER}) 停止中（./p2 start で起動）"; WARN=$((WARN+1))
  fi

  # 7. Payload CMS（任意。6:00 収集は Local API 経由のため必須ではない）
  if http_ok "$CMS_URL/api/articles"; then
    ok "Payload API: HTTP 200（起動済み）"
  else
    warn "Payload API 応答なし（6:00 収集自体は node の Local API で動くため必須ではない。裏取り・候補提示で必要）"
  fi

  # 8. 必要コマンド
  local MISSING=""
  for c in node curl python3 jq docker; do
    command -v "$c" >/dev/null 2>&1 || MISSING="$MISSING $c"
  done
  if [ -z "$MISSING" ]; then ok "必要コマンド: node/curl/python3/jq/docker すべて解決"
  else warn "不足コマンド:$MISSING"; WARN=$((WARN+1)); fi

  echo "------------------------------------------------"
  if [ "$WARN" -eq 0 ]; then
    ok "早朝 preflight: 問題なし（6:00 収集を実行できる状態）"
  else
    warn "早朝 preflight: 注意 ${WARN} 件（上記を確認。多くは夜間の準備で解消）"
  fi
  echo
  echo "▼ 5:50 自動復帰が必要な場合（OS 設定変更。Claude は実行しません。マロンが実行）"
  echo "   現在値 : $(pmset -g sched 2>/dev/null | grep -iE 'wake|poweron' | head -1 | sed 's/^ *//')"
  echo "   変更案 : sudo pmset repeat wakeorpoweron MTWRFSU 05:50:00"
  echo "   確認   : pmset -g sched"
  echo "   復元   : sudo pmset repeat wakeorpoweron MTWRFSU 06:55:00   （元の 6:55 に戻す）"
  echo "           sudo pmset repeat cancel                            （繰り返しイベントを全解除）"
  echo "================================================"
  echo
}

# ─────────────────────────────────────────────────────────────
# 明朝運用パイプラインの単一経路（P0 2026-09-02 続き）
#   ./p2 am-run   … preflight → 収集確認 → 重複除去 → （--fetch 時）公式/詳細/PDF 取得確認
#                    → ArticleFacts 候補抽出 → A/B/C 判定 → 画像 preflight → 7:10 レポート
#                    レポートと候補プロポーザルを .devlogs/morning/<date>/ へ保存（DB 書き込みなし）
#   ./p2 am-candidates … 上の読み取り専用ビュー（ファイル保存も外部取得もしない）
#   実体は cms/src/scripts/morningRun.ts（唯一のオーケストレーター）。
#   Claude API・課金・DB 書き込み・note/Chrome/X 操作・自動公開は一切なし。
#   ロックで二重起動を防止。1件の失敗で全体を止めない。
# ─────────────────────────────────────────────────────────────
_am_run_impl() {
  # $1 以降を morningRun.ts へそのまま渡す
  local JSON_MODE=0
  for a in "$@"; do [ "$a" = "--json" ] && JSON_MODE=1; done

  if ! docker info >/dev/null 2>&1 ||
     [ "$(docker inspect -f '{{.State.Running}}' "$DB_CONTAINER" 2>/dev/null)" != "true" ]; then
    fail "PostgreSQL が起動していません（先に ./p2 start を実行してください）"
    return 1
  fi

  # Payload/drizzle の起動ノイズは stderr へ寄せ、stdout は本文 or JSON のみ
  (cd "$ROOT/cms" && node --env-file=.env --import=tsx/esm src/scripts/morningRun.ts "$@" 2>"$LOG_DIR/am-run.log")
  local RC=$?
  if [ "$RC" -eq 3 ]; then
    warn "morning パイプラインは前回処理が未完了のため安全停止しました（二重実行防止）"
    tail -5 "$LOG_DIR/am-run.log" 2>/dev/null
    return 3
  fi
  if [ "$RC" -ne 0 ]; then
    fail "候補レポートの生成に失敗しました（rc=$RC）"
    echo "--- $LOG_DIR/am-run.log 末尾 ---"
    tail -20 "$LOG_DIR/am-run.log" 2>/dev/null
    return "$RC"
  fi
  return 0
}

am_run() {
  echo
  echo "=== GINZA WHISKERS / Project 02 明朝パイプライン（単一経路・7:10 候補レポート） ==="
  echo "（DB 書き込み・Claude API・課金・note/Chrome/X 操作・自動公開なし。--fetch なしなら外部リクエスト 0 件）"
  _am_run_impl "$@"
  local RC=$?
  echo "================================================"
  echo
  return "$RC"
}

candidate_review() {
  # 読み取り専用・1コマンド完結の候補レビュー資料（2026-09-06）。
  # DB書き込み・AI呼び出し・ready化・記事作成・公開・push・note/Chrome/X操作は一切しない。
  # 外部通信は指定候補の公式ページへの通常HTTP GETのみ（--no-fetchで無効化可）。
  if [ $# -eq 0 ]; then
    echo "Usage: ./p2 candidate-review <dcId...> [--no-fetch] [--json]"
    return 1
  fi
  local JSON_MODE=0
  for a in "$@"; do [ "$a" = "--json" ] && JSON_MODE=1; done
  if ! docker info >/dev/null 2>&1 ||
     [ "$(docker inspect -f '{{.State.Running}}' "$DB_CONTAINER" 2>/dev/null)" != "true" ]; then
    fail "PostgreSQL が起動していません（先に ./p2 start を実行してください）"
    return 1
  fi
  if [ "$JSON_MODE" -eq 0 ]; then
    echo
    echo "=== GINZA WHISKERS / Project 02 候補レビュー資料（読み取り専用・1コマンド完結） ==="
  fi
  (cd "$ROOT/cms" && node --env-file=.env --import=tsx/esm src/scripts/candidateReview.ts "$@" 2>"$LOG_DIR/candidate-review.log")
  local RC=$?
  if [ "$RC" -ne 0 ]; then
    fail "候補レビュー資料の生成に失敗しました（rc=$RC）"
    tail -20 "$LOG_DIR/candidate-review.log" 2>/dev/null
    return "$RC"
  fi
  [ "$JSON_MODE" -eq 0 ] && { echo "================================================"; echo; }
  return 0
}

am_candidates() {
  # 読み取り専用ビュー：ファイル保存も外部取得もしない
  local JSON_MODE=0
  for a in "$@"; do [ "$a" = "--json" ] && JSON_MODE=1; done
  if [ "$JSON_MODE" -eq 0 ]; then
    echo
    echo "=== GINZA WHISKERS / Project 02 A/B/C 候補レポート（読み取り専用ビュー） ==="
    echo "（--no-write 相当。ファイル保存・外部取得なし。フル実行は ./p2 am-run または ./p2 morning）"
  fi
  _am_run_impl --no-write "$@"
  local RC=$?
  [ "$JSON_MODE" -eq 0 ] && { echo "================================================"; echo; }
  return "$RC"
}

case "${1:-status}" in
  start)
    start_all
    ;;
  stop)
    stop_all
    ;;
  restart)
    stop_all
    start_all
    ;;
  status)
    health
    ;;
  doctor)
    doctor
    ;;
  editorial)
    editorial
    ;;
  social)
    social
    ;;
  sources)
    shift
    if [ "${1:-}" = "coverage" ]; then
      shift
      ( cd "$ROOT/cms" && node --env-file=.env --import=tsx/esm src/scripts/sourceCoverage.ts "$@" 2>"$LOG_DIR/source_coverage.log" ) || {
        fail "収集カバレッジ診断スクリプトの実行に失敗しました"
        tail -15 "$LOG_DIR/source_coverage.log" 2>/dev/null
        return 1
      }
    else
      sources
    fi
    ;;
  crawl)
    shift
    crawl "$@"
    ;;
  tns)
    shift
    tns_dispatch "$@"
    ;;
  interest)
    shift
    interest_dispatch "$@"
    ;;
  night)
    shift
    night_dispatch "$@"
    ;;
  score)
    shift
    score "$@"
    ;;
  ranking)
    ranking "$2"
    ;;
  articles)
    articles
    ;;
  score-articles)
    shift
    score_articles "$@"
    ;;
  daily)
    daily
    ;;
  draft-today)
    shift
    draft_today "$@"
    ;;
  draft-from-dc)
    shift
    draft_from_dc "$@"
    ;;
  draft-interest)
    shift
    draft_interest "$@"
    ;;
  template-check)
    shift
    template_check "$@"
    ;;
  draft-template)
    shift
    draft_template "$@"
    ;;
  themes)
    shift
    # 候補選定の自動化（読み取り専用）。推奨10＋予備5（合計15固定）＋バランス表。
    # DB 書き込み・AI 呼び出し・課金なし。
    case "$1" in
      recommend)
        shift
        if ! docker info >/dev/null 2>&1 ||
           [ "$(docker inspect -f '{{.State.Running}}' "$DB_CONTAINER" 2>/dev/null)" != "true" ]; then
          # --fixture 指定時は DB 不要
          case " $* " in *" --fixture="*) : ;; *)
            fail "PostgreSQL が起動していません（先に ./p2 start）。--fixture=path で DB なし検証も可"
            return 1 2>/dev/null || exit 1 ;;
          esac
        fi
        ( cd "$ROOT/cms" && node --env-file=.env --import=tsx/esm src/scripts/themesRecommend.ts "$@" )
        ;;
      *)
        echo "Usage: ./p2 themes recommend [--limit=N] [--include-approved] [--from-report[=date]] [--fixture=path.json] [--json]"
        echo "  既定は承諾前（curationStatus=inbox）の候補を read-only 評価 → 推奨10＋予備5。DB書き込みなし。"
        return 1 2>/dev/null || exit 1
        ;;
    esac
    ;;
  pipeline)
    shift
    # テーマ承認後の自動制作パイプライン（記事化→裏取り→監査→green/yellow/red→note下書き候補）。
    # 既定 dry-run（DB書き込みなし）。--yes で green/yellow を Article(reviewStatus:draft) 化。
    # 有料APIなし・auto-readyなし・自動公開なし。4:00/6:00の収集には接続しない（承認後に手動起動）。
    echo
    echo "=== GINZA WHISKERS / Project 02 自動制作パイプライン（pipeline） ==="
    if ! docker info >/dev/null 2>&1 ||
       [ "$(docker inspect -f '{{.State.Running}}' "$DB_CONTAINER" 2>/dev/null)" != "true" ]; then
      fail "PostgreSQL が起動していません（先に ./p2 start を実行してください）"
      echo "================================================"; echo
      return 1 2>/dev/null || exit 1
    fi
    _PIPE_LOG="$LOG_DIR/pipeline.log"
    _PIPE_OUT="$( cd "$ROOT/cms" && node --env-file=.env --import=tsx/esm src/scripts/pipelineRun.ts "$@" 2>"$_PIPE_LOG" )"
    _pipe_rc=$?
    if [ "$_pipe_rc" -ne 0 ]; then
      fail "pipeline の実行に失敗しました"
      tail -20 "$_PIPE_LOG" 2>/dev/null
      echo "================================================"; echo
      return $_pipe_rc 2>/dev/null || exit $_pipe_rc
    fi
    # 末尾の1行JSONをフォーマッタへ、それ以外はそのまま表示
    echo "$_PIPE_OUT" | grep -v '^{'
    echo "$_PIPE_OUT" | grep '^{' | tail -1 | python3 "$ROOT/scripts/format_pipeline_status.py" 2>/dev/null || true
    echo "================================================"; echo
    ;;
  bypass-draft)
    shift
    # 8:15 迂回経路（RUNBOOK 付録G.21）。confirmed の事実だけから note 用 Markdown を生成。
    # DB 書き込み・ready 化・note/X 投稿・課金なし。既定 dry-run（--write でファイル出力）。
    if [ -z "$1" ]; then
      echo "Usage: ./p2 bypass-draft <DiscoveredContent の数値ID> --reason=\"標準経路で詰まった理由\" [--write]"
      echo "  例: ./p2 bypass-draft 390 --reason=\"exhibition だが venues が公式で取れず ready 化に15分超\"           # dry-run"
      echo "      ./p2 bypass-draft 390 --reason=\"...\" --write   # content/drafts/<date>-<slug>-bypass.md ＋ 迂回ログ出力"
      echo "  confirmed の事実だけを本文へ。未確認は「確認事項」として分離。マロンが判断して起動する（無人実行しない）。"
      return 1 2>/dev/null || exit 1
    fi
    if ! docker info >/dev/null 2>&1 ||
       [ "$(docker inspect -f '{{.State.Running}}' "$DB_CONTAINER" 2>/dev/null)" != "true" ]; then
      fail "PostgreSQL が起動していません（先に ./p2 start）"
      return 1 2>/dev/null || exit 1
    fi
    ( cd "$ROOT/cms" && node --env-file=.env --import=tsx/esm src/scripts/bypassDraft.ts "$@" )
    ;;
  crossculture)
    shift
    # GINZA CROSS CULTURE MAP（5市場）FILTER。GINZA WHISKERS 適合判定の後段。
    # 決定的・AI なし・ネットワークなし・DB 書き込みなし・追加課金なし。結果は .devlogs/crossculture/ にキャッシュ。
    case "$1" in
      theme|config)
        ( cd "$ROOT/cms" && node --env-file=.env --import=tsx/esm src/scripts/crossCultureRun.ts "$@" )
        ;;
      run|audit)
        if ! docker info >/dev/null 2>&1 ||
           [ "$(docker inspect -f '{{.State.Running}}' "$DB_CONTAINER" 2>/dev/null)" != "true" ]; then
          fail "PostgreSQL が起動していません（先に ./p2 start）。DB 不要の単発判定は ./p2 crossculture theme \"...\""
          return 1 2>/dev/null || exit 1
        fi
        ( cd "$ROOT/cms" && node --env-file=.env --import=tsx/esm src/scripts/crossCultureRun.ts "$@" )
        ;;
      derive)
        shift
        # CROSS CULTURE 派生記事の生成。既定 dry-run（プラン＋注入プロンプト表示・DB書き込み/AI/課金なし）。
        # --yes で ginza_whiskers 角度の別候補(reviewStatus:draft)を生成（通常記事は上書きしない）。
        if ! docker info >/dev/null 2>&1 ||
           [ "$(docker inspect -f '{{.State.Running}}' "$DB_CONTAINER" 2>/dev/null)" != "true" ]; then
          fail "PostgreSQL が起動していません（先に ./p2 start）"
          return 1 2>/dev/null || exit 1
        fi
        ( cd "$ROOT/cms" && node --env-file=.env --import=tsx/esm src/scripts/crossCultureDerive.ts "$@" )
        ;;
      *)
        echo "Usage: ./p2 crossculture <theme|run|audit|derive|config>"
        echo "  theme \"<自由テキスト>\" [--json]              DB 不要の単発判定"

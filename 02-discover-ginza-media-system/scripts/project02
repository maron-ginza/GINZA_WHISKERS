score() {
  echo
  echo "=== GINZA WHISKERS / Project 02 「旬の銀座」Editorial Score採点 ==="

  if ! docker info >/dev/null 2>&1 ||
     [ "$(docker inspect -f '{{.State.Running}}' "$DB_CONTAINER" 2>/dev/null)" != "true" ]; then
    fail "PostgreSQL が起動していません（先に ./p2 start を実行してください）"
    echo "================================================"
    echo
    return 1
  fi

  MODE_ARGS=""
  for a in "$@"; do
    if [ "$a" = "--force" ]; then
      MODE_ARGS="$MODE_ARGS --force"
    fi
  done

  # ANTHROPIC_API_KEYの形式を事前チェックし、無効そうな場合は自動でヒューリスティック
  # 仮採点（本物のAI評価ではないローカル検証用モード）へフォールバックする
  # （マロン指示：外部APIキーは変更せず、使えない場合はローカルで検証可能な方法を使う）。
  if [ -f "$ROOT/cms/.env" ]; then
    check_anthropic_key_format "$ROOT/cms/.env" >/dev/null 2>&1
  fi

  if [ "${ANTHROPIC_KEY_OK:-0}" = "1" ] && ! printf '%s' "$*" | grep -qe '--heuristic'; then
    echo "（ANTHROPIC_API_KEYが有効な形式のため、実際のClaude呼び出しで採点します）"
  else
    MODE_ARGS="$MODE_ARGS --heuristic"
    warn "ANTHROPIC_API_KEYが未設定・無効な形式、または--heuristic指定のため、"
    warn "ヒューリスティック仮採点（本物のAI評価ではない）で実行します"
  fi

  RAW=$(cd "$ROOT/cms" && node --env-file=.env --import=tsx/esm src/scripts/scoreSources.ts $MODE_ARGS 2>"$LOG_DIR/score.log" | tail -1)

  if [ -z "$RAW" ]; then
    fail "採点スクリプトの実行に失敗しました"
    echo "--- $LOG_DIR/score.log 末尾 ---"
    tail -15 "$LOG_DIR/score.log" 2>/dev/null
    echo "================================================"
    echo
    return 1
  fi

  echo "$RAW" | python3 "$ROOT/scripts/format_score_status.py" "$LOG_DIR/score.log"

  echo "================================================"
  echo
}


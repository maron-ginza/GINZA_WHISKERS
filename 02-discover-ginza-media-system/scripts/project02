  echo
  echo "=== GINZA WHISKERS / Project 02 🌈TNS 状態確認 ==="

  if ! docker info >/dev/null 2>&1 ||
     [ "$(docker inspect -f '{{.State.Running}}' "$DB_CONTAINER" 2>/dev/null)" != "true" ]; then
    fail "PostgreSQL が起動していません（先に ./p2 start を実行してください）"
    echo "================================================"
    echo
    return 1
  fi

  # Payload内部ロガーの警告が標準出力に混ざる場合があるため、`^{`で始まる行
  # （JSON本体）だけを抽出する（tns_import_tracksと同じ対策）。
  RAW=$(cd "$ROOT/cms" && node --env-file=.env --import=tsx/esm src/scripts/tnsStatus.ts 2>"$LOG_DIR/tns_status.log" | grep '^{' | tail -1)

  if [ -z "$RAW" ]; then
    fail "TNS状態確認スクリプトの実行に失敗しました"
    echo "--- $LOG_DIR/tns_status.log 末尾 ---"
    tail -15 "$LOG_DIR/tns_status.log" 2>/dev/null
    echo "================================================"
    echo
    return 1
  fi

  echo "$RAW" | python3 -m json.tool
  echo "================================================"
  echo
}

tns_dispatch() {
  case "$1" in
    import-tracks)
      shift
      tns_import_tracks "$@"
      ;;
    next)
      shift
      tns_next "$@"
      ;;
    status)
      tns_status
      ;;
    approve)
      echo "./p2 tns approve は今回は設計のみで未実装です。"
      echo "将来、承認済みSoundtrackEditionをfinal approval状態へ進め、"
      echo "MusicUsageLedgerへ本番使用済み登録する専用コマンドとして実装予定です。"
      echo "note自動投稿・記事publishはこのコマンドの将来実装にも一切含めない方針です。"
      return 1
      ;;
    *)
      echo "Usage:"
      echo "  ./p2 tns import-tracks <file.csv|file.json> [--dry-run]"
      echo "  ./p2 tns next --yes [--dry-run] [\"観察テキスト\"]"
      echo "  ./p2 tns status"
      echo "  ./p2 tns approve  (設計のみ、未実装)"
      return 1
      ;;
  esac
}

interest_fetch_note_rising() {
  echo
  echo "=== GINZA WHISKERS / Project 02-2 Interest Discovery：note急上昇タグ取得 ==="

  if ! docker info >/dev/null 2>&1 ||
     [ "$(docker inspect -f '{{.State.Running}}' "$DB_CONTAINER" 2>/dev/null)" != "true" ]; then
    fail "PostgreSQL が起動していません（先に ./p2 start を実行してください）"
    echo "================================================"
    echo
    return 1
  fi

  DRY_RUN_ARG=""
  for arg in "$@"; do
    case "$arg" in
      --dry-run) DRY_RUN_ARG="--dry-run" ;;
    esac
  done

  if [ -n "$DRY_RUN_ARG" ]; then
    echo "（Dry Runモード：note.com/trendの取得・パースのみ確認。DBへの保存は行いません）"
  fi

  # Claude API・有料APIは呼び出さない（note.com/trendへの公開HTMLページGETのみ）。
  # Payload内部ロガーの警告が標準出力に混ざる場合があるため、`^{`で始まる行
  # （JSON本体）だけを抽出する（tns系コマンドと同じ対策）。
  RAW=$(cd "$ROOT/cms" && node --env-file=.env --import=tsx/esm src/scripts/interestFetchNoteRising.ts $DRY_RUN_ARG 2>"$LOG_DIR/interest_fetch_note_rising.log" | grep '^{' | tail -1)

  if [ -z "$RAW" ]; then
    fail "note急上昇タグ取得スクリプトの実行に失敗しました"
    echo "--- $LOG_DIR/interest_fetch_note_rising.log 末尾 ---"
    tail -20 "$LOG_DIR/interest_fetch_note_rising.log" 2>/dev/null
    echo "================================================"
    echo
    return 1
  fi

  echo "$RAW" | python3 -m json.tool
  echo "================================================"
  echo
}


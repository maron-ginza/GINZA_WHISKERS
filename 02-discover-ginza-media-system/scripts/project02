tns_dispatch() {
  case "$1" in
    import-tracks)
      shift
      tns_import_tracks "$@"
      ;;
    next)
      shift
      tns_next "$@"
      ;;
    status)
      tns_status
      ;;
    approve)
      echo "./p2 tns approve は今回は設計のみで未実装です。"
      echo "将来、承認済みSoundtrackEditionをfinal approval状態へ進め、"
      echo "MusicUsageLedgerへ本番使用済み登録する専用コマンドとして実装予定です。"
      echo "note自動投稿・記事publishはこのコマンドの将来実装にも一切含めない方針です。"
      return 1
      ;;
    *)
      echo "Usage:"
      echo "  ./p2 tns import-tracks <file.csv|file.json> [--dry-run]"
      echo "  ./p2 tns next --yes [--dry-run] [\"観察テキスト\"]"
      echo "  ./p2 tns status"
      echo "  ./p2 tns approve  (設計のみ、未実装)"
      return 1
      ;;
  esac
}


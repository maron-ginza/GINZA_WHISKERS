# 値は一切表示しない。「設定されているかどうか」の存在確認のみ行う。
check_env_var() {
  file="$1"
  var="$2"
  line=$(grep -E "^${var}=" "$file" 2>/dev/null | head -1)

  if [ -z "$line" ]; then
    warn "  $var : 未設定"
    return 1
  fi

  value="${line#*=}"
  if [ -z "$value" ]; then
    warn "  $var : 空文字（キーはあるが値が未入力）"
    return 1
  fi

  ok "  $var : 設定済み（値は表示しません）"
  return 0
}

# 値は一切表示しない。形式（sk-ant-プレフィックス・長さ・空白有無）のみで
# 「APIキーとして成立しているか」を判定する。実際の認証成功は保証しない
# （2026-08-10 実AI E2E検証セッションで、形式異常な値が.envに混入していた
# 事例があったため、日次チェックとして静的検査のみ追加した）。
check_anthropic_key_format() {
  file="$1"
  line=$(grep -E "^ANTHROPIC_API_KEY=" "$file" 2>/dev/null | head -1)
  ANTHROPIC_KEY_OK=0

  if [ -z "$line" ]; then
    return 1
  fi

  value="${line#*=}"
  len=${#value}

  if [ -z "$value" ]; then
    warn "  ANTHROPIC_API_KEY 形式チェック : 空文字のためスキップ"
    return 1
  fi

  case "$value" in
    sk-ant-*) prefix_ok=1 ;;
    *) prefix_ok=0 ;;
  esac

  case "$value" in
    *' '*) has_space=1 ;;
    *) has_space=0 ;;
  esac

  if [ "$prefix_ok" = "1" ] && [ "$has_space" = "0" ] && [ "$len" -lt 200 ]; then
    ok "  ANTHROPIC_API_KEY 形式チェック : 正常な形式に見えます（sk-ant-始まり、${len}文字。実際の認証成功は保証しません）"
    ANTHROPIC_KEY_OK=1
    return 0
  else
    warn "  ANTHROPIC_API_KEY 形式チェック : 異常の疑いあり（sk-ant-始まり=${prefix_ok}、空白含む=${has_space}、長さ=${len}文字。値は表示していません）"
    return 1
  fi
}

# === Railway / Cloudflare 読み取り専用ラッパー（2026-08-12新設） ===
#
# 背景：`railway domain` をサブコマンドなしで実行し、Postgresサービスに
# 公開ドメインを誤って作成する事故が発生した（発見後 `railway domain delete`
# で削除し、読み取り専用コマンドで復旧確認済み。実データ・デプロイ・環境変数
# への影響はなし）。原因は「一覧表示のつもりで叩いたコマンドが、実際には
# サブコマンド省略時に暗黙で『作成』動作をする」仕様を、実行前に`--help`で
# 確認していなかったこと。
#
# 再発防止として、以後Railway/Cloudflareの読み取り専用操作は必ずこの
# railway_ro / wrangler_ro を経由すること。ここに無い操作を実行する場合は、
# 生成AIエージェントは自動実行せず、実行直前で必ず停止して人間の承認を得る
# こと。新しい操作をここへ追加する前に、必ず `railway <cmd> --help` /
# `wrangler <cmd> --help` を読み、サブコマンド省略時に作成・変更が起きない
# ことを確認すること。
#
# 【許可リストに追加してはいけない操作（＝実行前に必ず人間の承認が必要）】
#   Railway: domain（create/update/delete）、variable set/delete、up、
#            deploy、redeploy、restart、down、delete、init、
#            service（create相当）、environment（create/delete）、volume、
#            scale、connect/ssh（本番DBへの対話シェル）、config apply、
#            usage limit set/update/remove（課金上限の変更）
#   Cloudflare: pages deploy、r2 bucket create/delete、deploy/publish、
#            kv:*、d1 *、secret put、login/logout
railway_ro() {
  case "$1" in
    whoami)              railway whoami ;;
    status)              railway status --json ;;
    domain-list)         shift; railway domain list --service "$1" ;;
    domain-status)       shift; railway domain status "$1" --service "$2" ;;
    deployment-list)     shift; railway deployment list --service "$1" ;;
    variable-list-keys)  shift; railway variable list --service "$1" --json 2>/dev/null | jq -r 'keys[]' ;;
    usage)               railway usage ;;
    usage-limit-status)  railway usage limit status ;;
    *)
      fail "railway_ro: 未許可の操作 '$1'（追加する前に railway <cmd> --help で安全性を確認してください）"
      return 1
      ;;
  esac
}

wrangler_ro() {
  case "$1" in
    whoami)              env -u CLOUDFLARE_API_TOKEN wrangler whoami ;;
    pages-project-list)  env -u CLOUDFLARE_API_TOKEN wrangler pages project list ;;
    r2-bucket-list)      env -u CLOUDFLARE_API_TOKEN wrangler r2 bucket list ;;
    *)
      fail "wrangler_ro: 未許可の操作 '$1'（追加する前に wrangler <cmd> --help で安全性を確認してください）"
      return 1
      ;;
  esac
}

# 現状Railway上に存在するサービス一覧（cmsサービスが将来デプロイされたら
# "Postgres cms" のように増やすだけでよい）
RAILWAY_KNOWN_SERVICES="Postgres"

prod_status() {
  echo
  echo "=== GINZA WHISKERS / Project 02 本番リソース状態（読み取り専用） ==="
  echo "作成・変更・削除・デプロイは一切行いません（railway_ro/wrangler_ro経由の読み取りのみ）"
  echo

  echo "--- Railway ---"
  if ! command -v railway >/dev/null 2>&1; then
    warn "railway CLI 未インストール"
  elif ! (cd "$ROOT/cms" && railway_ro whoami >/dev/null 2>&1); then
    warn "railway 未ログイン（本コマンドからはログインしません）"
  else
    ok "railway 認証: 有効"
    echo
    echo "  [usage（課金確認）]"
    (cd "$ROOT/cms" && railway_ro usage) | sed 's/^/  /'
    echo
    echo "  [status]"
    (cd "$ROOT/cms" && railway_ro status) | sed 's/^/  /'

    for svc in $RAILWAY_KNOWN_SERVICES; do
      echo
      echo "  [$svc: domains]"
      (cd "$ROOT/cms" && railway_ro domain-list "$svc") | sed 's/^/  /'
      echo
      echo "  [$svc: deployments]"
      (cd "$ROOT/cms" && railway_ro deployment-list "$svc") | sed 's/^/  /'
      echo
      echo "  [$svc: 環境変数キー一覧（値は表示しません）]"
      (cd "$ROOT/cms" && railway_ro variable-list-keys "$svc") | sed 's/^/    /'
    done
  fi

  echo
  echo "--- Cloudflare ---"
  if ! command -v wrangler >/dev/null 2>&1; then
    warn "wrangler CLI 未インストール"
  elif ! wrangler_ro whoami >/dev/null 2>&1; then
    warn "wrangler 未ログイン、または認証切れ（本コマンドからはログインしません）"
  else
    ok "wrangler 認証: 有効"
    echo
    echo "  [Cloudflare Pages プロジェクト一覧]"
    wrangler_ro pages-project-list | sed 's/^/  /'
    echo
    echo "  [R2 バケット一覧]"
    wrangler_ro r2-bucket-list | sed 's/^/  /'
  fi

  echo
  echo "================================================"
  echo
}

pmo() {
  morning || return 1
  prod_status
}

preflight() {
  echo
  echo "=== GINZA WHISKERS / Project 02 Phase 12 Preflight（本番インフラ構築準備） ==="
  echo "外部アカウント作成・課金操作・DNS変更・本番公開は行いません（調査・ローカル検証のみ）"
  echo

  echo "--- 1. デプロイ関連ファイルの存在確認 ---"
  [ -f "$ROOT/cms/railway.json" ] && ok "cms/railway.json（Railway build/start/healthcheck設定）" || warn "cms/railway.json が見つかりません"
  [ -f "$ROOT/cms/docker-compose.yml" ] && ok "cms/docker-compose.yml（ローカルPostgres用、本番では不使用）" || warn "cms/docker-compose.yml が見つかりません"
  grep -q '"engines"' "$ROOT/site/package.json" 2>/dev/null && ok "site/package.json に engines.node 指定あり" || warn "site/package.json に engines.node がありません"
  [ -f "$ROOT/cms/.env.example" ] && ok "cms/.env.example" || warn "cms/.env.example が見つかりません"
  [ -f "$ROOT/site/.env.example" ] && ok "site/.env.example" || warn "site/.env.example が見つかりません"

  echo
  echo "--- 2. cms/.env の必須環境変数（名前のみ確認、値は表示しません） ---"
  if [ -f "$ROOT/cms/.env" ]; then
    db_ok=1
    check_env_var "$ROOT/cms/.env" "DATABASE_URI" || db_ok=0
    if [ "$db_ok" = "0" ]; then
      check_env_var "$ROOT/cms/.env" "DATABASE_URL" && db_ok=1
    fi
    [ "$db_ok" = "1" ] || warn "  DATABASE_URI / DATABASE_URL のいずれも未設定です"
    check_env_var "$ROOT/cms/.env" "PAYLOAD_SECRET"
    check_env_var "$ROOT/cms/.env" "R2_BUCKET"
    check_env_var "$ROOT/cms/.env" "R2_ENDPOINT"
    check_env_var "$ROOT/cms/.env" "R2_ACCESS_KEY_ID"
    check_env_var "$ROOT/cms/.env" "R2_SECRET_ACCESS_KEY"
    check_env_var "$ROOT/cms/.env" "ANTHROPIC_API_KEY" && check_anthropic_key_format "$ROOT/cms/.env"
    check_env_var "$ROOT/cms/.env" "X_API_BEARER_TOKEN"
    check_env_var "$ROOT/cms/.env" "IG_BUSINESS_ACCOUNT_ID"
    check_env_var "$ROOT/cms/.env" "IG_PAGE_ACCESS_TOKEN"
  else
    fail "cms/.env が存在しません"
  fi

  echo
  echo "--- 3. site/.env の必須環境変数（名前のみ確認） ---"
  if [ -f "$ROOT/site/.env" ]; then
    check_env_var "$ROOT/site/.env" "PAYLOAD_API_URL"
  else
    fail "site/.env が存在しません"
  fi

  echo
  echo "--- 4. デプロイ用CLIツールの検出（読み取りのみ、ログイン等は行いません） ---"
  RAILWAY_AUTH_OK=0
  WRANGLER_AUTH_OK=0

  if command -v railway >/dev/null 2>&1; then
    ok "railway CLI インストール済み"
    if railway whoami >/dev/null 2>&1; then
      ok "railway 認証: 有効"
      RAILWAY_AUTH_OK=1
    else
      warn "railway 認証: 未ログイン（本スクリプトからはログインしません。ユーザー側でのブラウザ操作が必要）"
    fi
  else
    warn "railway CLI 未インストール（Railwayダッシュボードでの手動設定が必要）"
  fi

  if command -v wrangler >/dev/null 2>&1; then
    ok "wrangler CLI インストール済み（$(wrangler --version 2>/dev/null | head -1)）"
    if wrangler whoami >/dev/null 2>&1; then
      ok "wrangler 認証: 有効"
      WRANGLER_AUTH_OK=1
    else
      warn "wrangler 認証: 無効または期限切れ（再ログインが必要、本スクリプトからは実行しません）"
    fi
  else
    warn "wrangler CLI 未インストール"
  fi

  echo
  echo "--- 5. ローカルビルド・型チェック ---"
  if (cd "$ROOT/cms" && npx tsc --noEmit >"$LOG_DIR/preflight_cms_tsc.log" 2>&1); then
    ok "cms: tsc --noEmit エラーなし"
  else
    known=$(grep -c "createDraftFromSource.ts" "$LOG_DIR/preflight_cms_tsc.log" 2>/dev/null || echo 0)
    total=$(grep -c "error TS" "$LOG_DIR/preflight_cms_tsc.log" 2>/dev/null || echo 0)
    if [ "$known" = "$total" ] && [ "$total" != "0" ]; then
      warn "cms: tsc --noEmit は既知の${total}件のみ（createDraftFromSource.ts、Phase 8以前からの既知エラー）"
    else
      fail "cms: tsc --noEmit で未知のエラーあり（詳細: $LOG_DIR/preflight_cms_tsc.log）"
    fi
  fi

  if (cd "$ROOT/site" && npx astro check >"$LOG_DIR/preflight_astro_check.log" 2>&1); then
    ok "site: astro check エラーなし"
  else
    fail "site: astro check でエラーあり（詳細: $LOG_DIR/preflight_astro_check.log）"
  fi

  echo
  echo "================================================"
  echo
}

# preflight() が設定したWRANGLER_AUTH_OK/RAILWAY_AUTH_OK/ANTHROPIC_KEY_OKを
# 読み、今日進めるべき工程を1つだけ提案する。優先順位は
# 「ローカル環境の健全性 > 外部認証の復旧 > APIキーの健全性 > 本番構築の続き」。
recommend_next_step() {
  echo "=== 今日の次の推奨工程（1つだけ） ==="

  if [ "${WRANGLER_AUTH_OK:-0}" != "1" ]; then
    echo "→ wrangler login を実行し、Cloudflareの認証を復旧してください（本コマンドからは自動実行しません）"
  elif [ "${RAILWAY_AUTH_OK:-0}" != "1" ]; then
    echo "→ railway login を実行し、Railwayの認証を完了してください（ブラウザでの操作が必要、本コマンドからは自動実行しません）"
  elif [ "${ANTHROPIC_KEY_OK:-0}" != "1" ]; then
    echo "→ cms/.env の ANTHROPIC_API_KEY を、Anthropicコンソールで発行した有効な値（sk-ant-で始まる）に差し替えてください"
  elif [ "${JOBS_RECENT_FAILURE:-0}" = "1" ]; then
    echo "→ SOURCE LEDGER自動巡回（Jobs Queue）に直近の失敗があります。./p2 jobs で詳細を確認してください"
  else
    echo "→ 付録Fの手順で Cloudflare Pages / Railway デプロイ / R2 有効化など、本番インフラの実際の構築を進めてください（各サービスのダッシュボード操作が必要）"
  fi

  echo
}

morning() {
  echo
  echo "🌅 Project 02 Morning Startup — $(date '+%Y-%m-%d %H:%M:%S')"
  echo "外部ログイン・課金操作・本番デプロイは行いません（ローカル起動・診断・状態確認のみ）"
  echo

  ensure_env || {
    echo
    echo "次の1操作: cms/.env（と必要ならsite/.env）を用意してから ./p2 morning を再実行してください"
    return 1
  }

  echo "--- 1-2. Docker Engine / PostgreSQL ---"
  if ! wait_docker; then
    echo
    echo "次の1操作: Docker Desktopを手動起動し、再度 ./p2 morning を実行してください"
    return 1
  fi

  if ! docker inspect "$DB_CONTAINER" >/dev/null 2>&1; then
    fail "PostgreSQL container が見つかりません"
    echo
    echo "次の1操作: cms/docker-compose.yml の存在を確認し 'docker compose up -d' を実行してください"
    return 1
  fi

  if [ "$(docker inspect -f '{{.State.Running}}' "$DB_CONTAINER" 2>/dev/null)" = "true" ]; then
    ok "PostgreSQL already running"
  else
    if ! docker start "$DB_CONTAINER" >/dev/null; then
      fail "PostgreSQL 起動失敗"
      echo
      echo "次の1操作: docker logs $DB_CONTAINER でエラー内容を確認してください"
      return 1
    fi
    ok "PostgreSQL started"
  fi

  echo
  echo "--- 3. Payload CMS ---"
  start_cms
  if ! http_ok "$CMS_URL/api/articles"; then
    echo
    echo "次の1操作: tail -50 $LOG_DIR/cms.log でエラー内容を確認してください"
    return 1
  fi

  echo
  echo "--- 4. Astro ---"
  start_site
  if ! http_ok "$SITE_URL/ja/"; then
    echo
    echo "次の1操作: tail -50 $LOG_DIR/site.log でエラー内容を確認してください"
    return 1
  fi

  echo
  echo "--- 5. ./p2 status 相当 ---"
  health

  echo "--- 6. ./p2 doctor 相当（診断ログ） ---"
  dump_logs

  echo "--- 7. ./p2 editorial 相当 ---"
  editorial

  echo "--- 8. ./p2 social 相当 ---"
  social

  echo "--- 9. ./p2 jobs 相当（SOURCE LEDGER定期実行の状態確認、読み取り専用） ---"
  jobs

  echo "--- 10〜12. Phase 12 Preflight状態確認（Claude APIキー形式・Railway/Cloudflare認証は警告表示のみ、ログインは行いません） ---"
  preflight

  recommend_next_step

  echo "🌅 Project 02 Morning Startup 完了"
  echo
}

case "${1:-status}" in
  start)
    start_all
    ;;
  stop)
    stop_all
    ;;
  restart)
    stop_all
    start_all
    ;;
  status)
    health
    ;;
  doctor)
    doctor
    ;;
  editorial)
    editorial
    ;;
  social)
    social
    ;;
  sources)
    sources
    ;;
  crawl)
    shift
    crawl "$@"
    ;;
  tns)
    shift
    tns_dispatch "$@"
    ;;
  interest)
    shift
    interest_dispatch "$@"
    ;;
  score)
    shift
    score "$@"
    ;;
  ranking)
    ranking "$2"
    ;;
  articles)
    articles
    ;;
  score-articles)
    shift
    score_articles "$@"
    ;;
  daily)
    daily
    ;;
  clusters)
    clusters "$2"
    ;;
  refresh-dates)
    shift
    refresh_dates "$@"
    ;;
  recompute-richness)
    shift
    recompute_richness "$@"
    ;;
  recompute-ux-type)
    shift
    recompute_ux_type "$@"
    ;;
  jobs)
    jobs
    ;;
  preflight)
    preflight
    ;;
  morning)
    morning
    ;;
  prod-status)
    prod_status
    ;;
  pmo)
    pmo
    ;;
  open)
    open "$SITE_URL/ja/"
    open "$CMS_URL/admin"
    ;;
  *)
    echo "Project 02 Automation"
    echo
    echo "  ./p2 start      起動＋自動診断"
    echo "  ./p2 stop       安全終了"
    echo "  ./p2 restart    再起動"
    echo "  ./p2 status     状態確認"
    echo "  ./p2 doctor     異常時診断"
    echo "  ./p2 editorial  編集パイプライン状況（Sources/Articles集計、承認待ち一覧）"
    echo "  ./p2 social     SNS配信キュー状況（Phase 15、候補生成＋Dry Run＋承認待ち一覧）"
    echo "  ./p2 sources    SOURCE LEDGER v1（情報源台帳）確認（件数・tier別・Core Source一覧、DB不要）"
    echo "  ./p2 crawl [--dry-run] [--budget=N]  SOURCE LEDGERのenabled情報源を巡回しSnapshot保存・差分検知＋一覧ページ発見＋個別記事・イベント抽出（--dry-runはDB書き込みなし、--budget=NはStage2予算の既定20を上書き。手動実行用。定期実行はPayload Jobs Queueが自動で行う）"
    echo "  ./p2 tns import-tracks <file> [--dry-run]  TNS MusicTracks候補曲の一括インポート（CSV/JSON、title×artist重複チェック・verified=false既定、--dry-runはDB書き込みなし。テンプレートはcms/import-templates/参照）"
    echo "  ./p2 tns next --yes [--dry-run] [\"観察テキスト\"]  次週TNS Draft生成（天気→選曲→記事draft作成→人間確認待ち。--yes必須＝Claude API課金の確認、--dry-runはDB保存なしで内容確認のみ、観察テキスト省略時は既定値を使用。同一週の二重生成は自動的にブロックされる）"
    echo "  ./p2 tns status  最新TNS editionの状態確認（号数・対象週・Article ID・reviewStatus・visualStatus・承認状態、読み取り専用）"
    echo "  ./p2 tns approve  将来のfinal approval／MusicUsageLedger本番登録コマンド（今回は設計のみ・未実装）"
    echo "  ./p2 interest fetch-note-rising [--dry-run]  Project 02-2 Phase A試験取得：note.com/trend急上昇タグ上位5件をInterestThemesへ保存（Claude API・有料API呼び出しなし、本日分は自動的に二重取得防止）"
    echo "  ./p2 interest fetch-note-official [--dry-run]  Project 02-2 Phase A試験取得：note.com/info/rssから現在開催中と推定できるお題/コンテストのみInterestThemesへ保存（confidence: low、同一企画は恒久的に重複防止、Claude API・有料API呼び出しなし）"
    echo "  ./p2 interest fetch-note-hashtag <tag> [--dry-run]  Project 02-2 Phase A試験取得：note.com/hashtag/<tag>（人気=既定ソート）の総記事数・関連タグをInterestThemesへ保存（confidence: high、本日分は自動的に二重取得防止、Claude API・有料API呼び出しなし）"
    echo "  ./p2 interest score  Project 02-2 Phase A統合ロジック：note_rising/note_official_topic/note_hashtag_popularを正規化・confidence比例配分・freshness減衰・cross-source overlapで統合しInterest Score降順表示（読み取り専用、DB書き込み・API呼び出しなし）"
    echo "  ./p2 score [--force]  「旬の銀座」Editorial Score/Audience Tags採点（サイト単位Inbox候補。鍵無効時は自動でヒューリスティック仮採点にフォールバック）"
    echo "  ./p2 ranking [--all]  Editorial Score順ランキング表示（サイト単位Inbox候補、既定は読み取り専用）"
    echo "  ./p2 articles   個別記事・イベント（DiscoveredContent）の現在状態サマリー（件数・公開日/開催期間取得状況、読み取り専用）"
    echo "  ./p2 score-articles [--force]  個別記事・イベント単位のEditorial Score/Audience Tags採点（鍵無効時は自動でヒューリスティック仮採点にフォールバック）"
    echo "  ./p2 daily      Daily Editorial Desk（本日新規/更新＋開催中＋近日開催、Story Cluster単位のTop10、読み取り専用）"
    echo "  ./p2 clusters [--dry-run]  Story Clustering再計算・StoryClustersコレクションへ反映（同一イベントの複数URLを統合、DiscoveredContentは変更しない）"
    echo "  ./p2 refresh-dates [--dry-run] [--limit=N] [--all]  既存DiscoveredContentの個別ページを安全に再確認（--allで全件対象・誤抽出の訂正も反映。新規行は作成せず、discoveryStatus/curationStatusも変更しない）"
    echo "  ./p2 recompute-richness [--dry-run]  既存の採点済みSources/DiscoveredContentへ本文情報量ペナルティを遡及反映（新規AI呼び出しなし・課金なし）"
    echo "  ./p2 recompute-ux-type [--dry-run]  既存DiscoveredContentへ参加／体験型UXタイプを遡及反映（新規AI呼び出しなし・課金なし）"
    echo "  ./p2 jobs       SOURCE LEDGER定期実行（Payload Jobs Queue）の状態確認（次回実行予定・直近の成功/失敗、読み取り専用）"
    echo "  ./p2 preflight  Phase 12本番インフラ構築の準備状況確認（env var名・CLI認証・ビルド）"
    echo "  ./p2 morning    朝の作業開始準備を1コマンドで完了（起動＋status/doctor/editorial/social/jobs/preflight＋次の推奨工程）"
    echo "  ./p2 prod-status Railway/Cloudflareの本番リソース状態を読み取り専用で確認（railway_ro/wrangler_ro経由のみ、値は表示しません）"
    echo "  ./p2 pmo        morning + prod-status をまとめて実行（PMOレポート作成用の一括データ収集）"
    echo "  ./p2 open       Site/CMSを開く"
    ;;
esac

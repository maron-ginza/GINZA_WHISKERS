#!/bin/bash

ROOT="$(cd "$(dirname "$0")/.." && pwd)"
LOG_DIR="$ROOT/.devlogs"
PID_DIR="$ROOT/.devpids"

CMS_URL="http://localhost:3000"
SITE_URL="http://localhost:4321"
DB_CONTAINER="cms-postgres-1"

mkdir -p "$LOG_DIR" "$PID_DIR"

ok()   { printf "✅ %s\n" "$1"; }
warn() { printf "⚠️  %s\n" "$1"; }
fail() { printf "❌ %s\n" "$1"; }

http_ok() {
  curl -fsS "$1" >/dev/null 2>&1
}

wait_docker() {
  if docker info >/dev/null 2>&1; then
    ok "Docker Engine"
    return 0
  fi

  echo "Docker Desktopを自動起動しています..."
  open -a Docker >/dev/null 2>&1 || true

  for i in $(seq 1 60); do
    if docker info >/dev/null 2>&1; then
      ok "Docker Engine started"
      return 0
    fi
    sleep 2
  done

  fail "Docker Engine 起動タイムアウト"
  return 1
}

wait_http() {
  url="$1"
  name="$2"

  for i in $(seq 1 60); do
    if http_ok "$url"; then
      ok "$name"
      return 0
    fi
    sleep 1
  done

  fail "$name 起動タイムアウト"
  return 1
}

ensure_env() {
  if [ ! -f "$ROOT/site/.env" ] && [ -f "$ROOT/site/.env.example" ]; then
    cp "$ROOT/site/.env.example" "$ROOT/site/.env"
    ok "site/.env created"
  fi

  if [ ! -f "$ROOT/cms/.env" ]; then
    fail "cms/.env がありません"
    return 1
  fi

  if [ ! -f "$ROOT/site/.env" ]; then
    fail "site/.env がありません"
    return 1
  fi

  ok "Environment files"
}

start_db() {
  wait_docker || exit 1

  if ! docker inspect "$DB_CONTAINER" >/dev/null 2>&1; then
    fail "PostgreSQL container が見つかりません"
    exit 1
  fi

  if [ "$(docker inspect -f '{{.State.Running}}' "$DB_CONTAINER" 2>/dev/null)" = "true" ]; then
    ok "PostgreSQL already running"
  else
    docker start "$DB_CONTAINER" >/dev/null || exit 1
    ok "PostgreSQL started"
  fi
}

start_cms() {
  if http_ok "$CMS_URL/api/articles"; then
    ok "Payload CMS already running"
    return
  fi

  (
    cd "$ROOT/cms" || exit 1
    nohup npm run dev > "$LOG_DIR/cms.log" 2>&1 &
    echo $! > "$PID_DIR/cms.pid"
  )

  wait_http "$CMS_URL/api/articles" "Payload CMS"
}

start_site() {
  if http_ok "$SITE_URL/ja/"; then
    ok "Astro already running"
    return
  fi

  (
    cd "$ROOT/site" || exit 1
    nohup npm run dev > "$LOG_DIR/site.log" 2>&1 &
    echo $! > "$PID_DIR/site.pid"
  )

  wait_http "$SITE_URL/ja/" "Astro Site"
}

stop_port() {
  port="$1"
  name="$2"
  found=0

  for pid in $(lsof -tiTCP:"$port" -sTCP:LISTEN 2>/dev/null); do
    kill "$pid" >/dev/null 2>&1 || true
    found=1
  done

  if [ "$found" = "1" ]; then
    ok "$name stopped"
  else
    ok "$name already stopped"
  fi
}

stop_all() {
  echo
  echo "🛑 Project 02 安全終了開始"

  stop_port 4321 "Astro"
  stop_port 3000 "Payload CMS"

  if docker info >/dev/null 2>&1 &&
     [ "$(docker inspect -f '{{.State.Running}}' "$DB_CONTAINER" 2>/dev/null)" = "true" ]; then
    docker stop "$DB_CONTAINER" >/dev/null
    ok "PostgreSQL stopped"
  else
    ok "PostgreSQL already stopped"
  fi

  rm -f "$PID_DIR/cms.pid" "$PID_DIR/site.pid"

  echo "✅ Project 02 安全終了完了"
  echo
}

health() {
  echo
  echo "=== GINZA WHISKERS / Project 02 Health Check ==="

  docker info >/dev/null 2>&1 \
    && ok "Docker Engine" \
    || fail "Docker Engine"

  [ "$(docker inspect -f '{{.State.Running}}' "$DB_CONTAINER" 2>/dev/null)" = "true" ] \
    && ok "PostgreSQL" \
    || fail "PostgreSQL"

  if http_ok "$CMS_URL/api/articles"; then
    ok "Payload API : HTTP 200"

    API="$CMS_URL/api/articles?where%5BreviewStatus%5D%5Bequals%5D=published&limit=100"

    COUNT=$(curl -fsS "$API" | python3 -c \
      'import sys,json; print(len(json.load(sys.stdin).get("docs",[])))' 2>/dev/null)

    TITLE=$(curl -fsS "$API" | python3 -c \
      'import sys,json; d=json.load(sys.stdin); x=d.get("docs",[]); print(x[0].get("title","") if x else "")' 2>/dev/null)

    ok "Published Articles : ${COUNT:-0}"
  else
    fail "Payload API"
    TITLE=""
  fi

  if http_ok "$SITE_URL/ja/"; then
    ok "Astro Japanese Site"
  else
    fail "Astro Japanese Site"
  fi

  if [ -n "$TITLE" ] && curl -fsS "$SITE_URL/ja/" | grep -Fq "$TITLE"; then
    ok "Payload → Astro Live Data"
  elif [ -z "$TITLE" ]; then
    warn "Payload → Astro : 公開記事なし"
  else
    fail "Payload → Astro Live Data"
  fi

  echo "================================================"
  echo
}

dump_logs() {
  echo "=== 自動診断ログ ==="

  if [ -f "$LOG_DIR/cms.log" ]; then
    echo "--- Payload CMS last 15 lines ---"
    tail -15 "$LOG_DIR/cms.log"
  fi

  if [ -f "$LOG_DIR/site.log" ]; then
    echo "--- Astro last 15 lines ---"
    tail -15 "$LOG_DIR/site.log"
  fi

  echo "=================="
}

doctor() {
  health
  dump_logs
}

editorial() {
  echo
  echo "=== GINZA WHISKERS / Project 02 編集パイプライン状況 ==="

  if ! docker info >/dev/null 2>&1 ||
     [ "$(docker inspect -f '{{.State.Running}}' "$DB_CONTAINER" 2>/dev/null)" != "true" ]; then
    fail "PostgreSQL が起動していません（先に ./p2 start を実行してください）"
    echo "================================================"
    echo
    return 1
  fi

  RAW=$(cd "$ROOT/cms" && node --env-file=.env --import=tsx/esm src/scripts/editorialStatus.ts 2>"$LOG_DIR/editorial.log" | tail -1)

  if [ -z "$RAW" ]; then
    fail "編集パイプライン集計スクリプトの実行に失敗しました"
    echo "--- $LOG_DIR/editorial.log 末尾 ---"
    tail -15 "$LOG_DIR/editorial.log" 2>/dev/null
    echo "================================================"
    echo
    return 1
  fi

  echo "$RAW" | python3 "$ROOT/scripts/format_editorial_status.py" "$LOG_DIR/editorial.log"

  echo "================================================"
  echo
}


refresh_dates() {
  echo
  echo "=== GINZA WHISKERS / Project 02 個別ページ日付再確認（Source Coverage拡張） ==="

  if ! docker info >/dev/null 2>&1 ||
     [ "$(docker inspect -f '{{.State.Running}}' "$DB_CONTAINER" 2>/dev/null)" != "true" ]; then
    fail "PostgreSQL が起動していません（先に ./p2 start を実行してください）"
    echo "================================================"
    echo
    return 1
  fi

  MODE_ARG=""
  LIMIT_ARG=""
  ALL_ARG=""
  for arg in "$@"; do
    if [ "$arg" = "--dry-run" ]; then
      MODE_ARG="--dry-run"
      echo "（Dry Runモード：実際にHTTP再取得は行いますが、DBへの書き込みは一切行いません）"
    fi
    if [ "$arg" = "--all" ]; then
      ALL_ARG="--all"
      echo "（全件モード：日付未取得の行だけでなく295件全件を再取得し、誤抽出の訂正も反映します）"
    fi
    case "$arg" in
      --limit=*) LIMIT_ARG="$arg" ;;
    esac
  done

  RAW=$(cd "$ROOT/cms" && node --env-file=.env --import=tsx/esm src/scripts/refreshDates.ts $MODE_ARG $LIMIT_ARG $ALL_ARG 2>"$LOG_DIR/refresh_dates.log" | tail -1)

  if [ -z "$RAW" ]; then
    fail "日付再確認スクリプトの実行に失敗しました"
    echo "--- $LOG_DIR/refresh_dates.log 末尾 ---"
    tail -15 "$LOG_DIR/refresh_dates.log" 2>/dev/null
    echo "================================================"
    echo
    return 1
  fi

  echo "$RAW" | python3 "$ROOT/scripts/format_refresh_dates_status.py" "$LOG_DIR/refresh_dates.log"

  echo "================================================"
  echo
}

recompute_richness() {
  echo
  echo "=== GINZA WHISKERS / Project 02 本文情報量ペナルティ再計算（Editorial Score） ==="

  if ! docker info >/dev/null 2>&1 ||
     [ "$(docker inspect -f '{{.State.Running}}' "$DB_CONTAINER" 2>/dev/null)" != "true" ]; then
    fail "PostgreSQL が起動していません（先に ./p2 start を実行してください）"
    echo "================================================"
    echo
    return 1
  fi

  MODE_ARG=""
  for arg in "$@"; do
    if [ "$arg" = "--dry-run" ]; then
      MODE_ARG="--dry-run"
      echo "（Dry Runモード：判定は行いますが、DBへの書き込みは一切行いません）"
    fi
  done
  echo "（新規のAI呼び出しは一切行いません。既存のEditorial Score・本文テキストのみで再計算します）"

  RAW=$(cd "$ROOT/cms" && node --env-file=.env --import=tsx/esm src/scripts/recomputeContentRichness.ts $MODE_ARG 2>"$LOG_DIR/recompute_richness.log" | tail -1)

  if [ -z "$RAW" ]; then
    fail "本文情報量ペナルティ再計算スクリプトの実行に失敗しました"
    echo "--- $LOG_DIR/recompute_richness.log 末尾 ---"
    tail -15 "$LOG_DIR/recompute_richness.log" 2>/dev/null
    echo "================================================"
    echo
    return 1
  fi

  echo "$RAW" | python3 "$ROOT/scripts/format_recompute_richness_status.py" "$LOG_DIR/recompute_richness.log"

  echo "================================================"
  echo
}


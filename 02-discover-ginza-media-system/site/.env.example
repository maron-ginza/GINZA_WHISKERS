# Payload CMS REST API (ビルド時にfetchする先)
# 本番(Railway)ではhttps://api.discover.ginzawhiskers.com（CLAUDE.md付録F参照）
PAYLOAD_API_URL=http://localhost:3000

# 検索エンジンへのインデックス許可スイッチ（src/lib/seo.ts）
# 未設定・空・'true'以外はすべて「インデックスさせない」＝robots.txtは
# Disallow: / を返し、全ページのmeta robotsがnoindex,nofollowになる。
# 10月ローンチ直前に true へ変更して再ビルド・再デプロイする
# （2026-08-13決定、CLAUDE.md第12章）。
SITE_INDEXABLE=false

---
import BaseLayout from '../../layouts/BaseLayout.astro'
import { fetchPublishedArticles, getHeroImageUrl } from '../../lib/payload'

let articles: Awaited<ReturnType<typeof fetchPublishedArticles>> = []
let fetchError: string | null = null

try {
  articles = await fetchPublishedArticles('ja')
} catch (err) {
  // Payload未起動時（ローカル開発・このサンドボックス環境）はビルドを止めずに空表示する
  fetchError = err instanceof Error ? err.message : String(err)
}
---

<BaseLayout
  title="Discover GINZA"
  locale="ja"
  description="銀座に積み重なる昭和浪漫の記憶を、資料として収蔵する。"
  canonicalPath="/ja/"
  alternatePath="/en/"
>
  <section class="ledger">
    <header class="ledger-header">
      <h1>台帳（Ledger）</h1>
      <p class="lede">銀座に積み重なる昭和浪漫の記憶を、資料として収蔵する。</p>
    </header>
    {fetchError && <p class="notice">記事の取得に失敗しました（CMS未起動の可能性）: {fetchError}</p>}
    {articles.length === 0 && !fetchError && <p class="notice">まだ収蔵された記事はありません。</p>}
    <ul class="archive-grid">
      {
        articles.map((article) => {
          const heroUrl = getHeroImageUrl(article)
          return (
            <li>
              <a class="card" href={`/ja/articles/${article.slug}`}>
                <div class:list={['card-thumb', { placeholder: !heroUrl }]}>
                  {heroUrl ? (
                    <img src={heroUrl} alt="" loading="lazy" />
                  ) : (
                    <span>{article.title.charAt(0)}</span>
                  )}
                </div>
                <div class="card-body">
                  <p class="card-meta">
                    {article.accessionNumber && <span>{article.accessionNumber}</span>}
                    {article.representedYear && <span>{article.representedYear}年</span>}
                    {!article.isTranslated && <span class="badge-pending">未翻訳</span>}
                  </p>
                  <h2 class="card-title">{article.title}</h2>
                  <p class="card-pillars">
                    {article.pillars.map((pillar) => (
                      <span class="pillar-tag">{pillar.name}</span>
                    ))}
                  </p>
                </div>
              </a>
            </li>
          )
        })
      }
    </ul>
  </section>
</BaseLayout>

<style>
  .ledger {
    max-width: 72rem;
    margin: 0 auto;
    padding: 2rem 2rem 5rem;
  }
  .ledger-header {
    margin-bottom: 2.5rem;
  }
  .ledger-header h1 {
    font-family: var(--font-display);
    font-size: 2rem;
    margin: 0 0 0.5rem;
    letter-spacing: 0.03em;
  }
  .lede {
    color: var(--color-ink-muted);
    margin: 0;
    font-size: 0.95rem;
  }
  .notice {
    color: var(--color-ink-muted);
    font-size: 0.9rem;
  }

  .archive-grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: 2rem 1.5rem;
  }
  .archive-grid > li {
    display: flex;
  }

  .card {
    display: flex;
    flex-direction: column;
    width: 100%;
    background: var(--color-card);
    border: 1px solid var(--color-accent-tint);
    text-decoration: none;
    color: inherit;
    transition:
      transform 0.15s ease,
      box-shadow 0.15s ease,
      border-color 0.15s ease;
  }
  .card:hover,
  .card:focus-visible {
    transform: translateY(-3px);
    box-shadow: 0 10px 24px rgba(36, 31, 24, 0.14);
    border-color: var(--color-accent);
  }

  .card-thumb {
    aspect-ratio: 4 / 3;
    background: var(--color-ground);
    overflow: hidden;
  }
  .card-thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .card-thumb.placeholder {
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .card-thumb.placeholder span {
    font-family: var(--font-display);
    font-size: 3rem;
    color: var(--color-accent-tint);
    opacity: 0.5;
  }

  .card-body {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    flex: 1;
    padding: 1.1rem 1.25rem 1.4rem;
  }

  .card-meta {
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.04em;
    color: var(--color-ink-muted);
  }

  .card-title {
    margin: 0;
    font-family: var(--font-display);
    font-size: 1.15rem;
    line-height: 1.5;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .card-pillars {
    margin: auto 0 0;
    padding-top: 0.3rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }
  .pillar-tag {
    font-size: 0.7rem;
    padding: 0.15rem 0.55rem;
    border: 1px solid var(--color-accent);
    color: var(--color-accent);
    border-radius: 999px;
  }
  .badge-pending {
    padding: 0.05rem 0.4rem;
    border: 1px dashed var(--color-accent-tint);
    color: var(--color-ink-muted);
  }

  @media (max-width: 640px) {
    .ledger {
      padding: 1.5rem 1.25rem 4rem;
    }
    .archive-grid {
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }
  }
</style>

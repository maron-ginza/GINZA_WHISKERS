---
import type { Locale } from '../lib/payload'

// index,follow ⇄ noindex,follow ⇄ noindex,nofollow を呼び出し側で自由に
// 切り替えられるようにするための型（Phase 7、翻訳未完了の英語ページ向け
// noindex運用を主目的とするが、将来の他用途にも流用できる形にしておく）
export type RobotsDirective = 'index,follow' | 'noindex,follow' | 'noindex,nofollow'

interface Props {
  title: string
  locale: Locale
  description: string
  // 自ページの正規URL（絶対ドメイン未確定のため当面はサイトルート相対パス）
  canonicalPath: string
  // hreflang alternate用のもう一方のロケールのパス。無ければ相互参照を出さない
  alternatePath?: string
  ogImage?: string | null
  robots?: RobotsDirective
}

const {
  title,
  locale,
  description,
  canonicalPath,
  alternatePath,
  ogImage = null,
  robots = 'index,follow',
} = Astro.props

const otherLocale: Locale = locale === 'ja' ? 'en' : 'ja'
const ogLocale = locale === 'ja' ? 'ja_JP' : 'en_US'
// astro.config.mjsのdefaultLocaleに合わせる（x-defaultの参照先）
const defaultLocalePath = locale === 'ja' ? canonicalPath : (alternatePath ?? canonicalPath)
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={robots} />
    <link rel="canonical" href={canonicalPath} />
    <link rel="alternate" hreflang={locale} href={canonicalPath} />
    {alternatePath && <link rel="alternate" hreflang={otherLocale} href={alternatePath} />}
    <link rel="alternate" hreflang="x-default" href={defaultLocalePath} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:locale" content={ogLocale} />
    {ogImage && <meta property="og:image" content={ogImage} />}
  </head>
  <body>
    <header class="site-header">
      <a href={`/${locale}/`} class="brand">Discover GINZA</a>
    </header>
    <main>
      <slot />
    </main>
    <footer class="site-footer">
      <p class="footer-links">
        <a href={`/${locale}/privacy`}>{locale === 'ja' ? 'プライバシーポリシー' : 'Privacy Policy'}</a>
      </p>
      <p class="footer-copy">&copy; Ginza Showa Roman Club. All Rights Reserved.</p>
    </footer>
  </body>
</html>

<style is:global>
  /* CLAUDE.md 第5章「台紙・アーカイブ」で確定したデザイントークン */
  :root {
    --color-ground: #e7ded0;
    --color-card: #f8f3e8;
    --color-ink: #241f18;
    --color-ink-muted: #786c58;
    --color-accent: #1f3f38;
    --color-accent-tint: #4d7a70;
    --font-display: 'Hiragino Mincho ProN', 'Noto Serif JP', serif;
    --font-body: 'Hiragino Kaku Gothic ProN', 'Noto Sans JP', sans-serif;
    --font-mono: 'SF Mono', 'Iowan Old Style', ui-monospace, monospace;
  }

  * {
    box-sizing: border-box;
  }

  body {
    margin: 0;
    background: var(--color-ground);
    color: var(--color-ink);
    font-family: var(--font-body);
  }

  .site-header {
    padding: 1.5rem 2rem;
    border-bottom: 1px solid var(--color-accent-tint);
  }

  .brand {
    font-family: var(--font-display);
    color: var(--color-ink);
    text-decoration: none;
    font-size: 1.25rem;
    letter-spacing: 0.05em;
  }

  .site-footer {
    padding: 2rem;
    border-top: 1px solid var(--color-accent-tint);
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .footer-links,
  .footer-copy {
    margin: 0;
    font-size: 0.78rem;
    color: var(--color-ink-muted);
  }

  .footer-links a {
    color: var(--color-ink-muted);
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .footer-links a:hover {
    color: var(--color-accent);
  }
</style>

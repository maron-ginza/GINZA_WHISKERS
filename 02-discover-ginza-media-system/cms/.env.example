# Postgres (Railway等の接続文字列)
# RailwayのPostgresプラグインは自動生成する変数名を DATABASE_URL とするため、
# 本番ではそのまま `DATABASE_URL` を使ってもよい（payload.config.tsが
# DATABASE_URI→DATABASE_URLの順にフォールバックする、2026-08-10対応）。
DATABASE_URI=postgres://user:password@localhost:5432/discover_ginza

# Payload
PAYLOAD_SECRET=replace-with-a-long-random-string

# Cloudflare R2 (画像ストレージ / TECH_SELECTION_DRAFT.md 3章)
R2_BUCKET=
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# AI記事生成 (Anthropic API)
ANTHROPIC_API_KEY=

# X API v2 (投稿ワーカー / 未実装スタブ。src/workers/postToX.ts参照)
X_API_BEARER_TOKEN=

# Instagram Graph API (投稿ワーカー / Meta App Review通過後に有効)
IG_BUSINESS_ACCOUNT_ID=
IG_PAGE_ACCESS_TOKEN=
